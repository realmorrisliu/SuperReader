def check(id_, feature, driver, status, detail, evidence=None):
    if status not in ("pass", "fail", "pending"):
        raise ValueError(status)
    row = {
        "id": id_,
        "feature": feature,
        "status": status,
        "driver": driver,
        "detail": detail,
    }
    if evidence:
        row["evidence"] = evidence
    return row


def median(values):
    xs = sorted(v for v in values if v == v)
    if not xs:
        return float("nan")
    mid = len(xs) // 2
    if len(xs) % 2 == 1:
        return xs[mid]
    return xs[mid - 1]


def decode_png_rows(path):
    return decode_png_bytes(Path(path).read_bytes())


def decode_png_bytes(data):
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a png")
    pos = 8
    width = height = None
    color = None
    idat = b""
    while pos + 8 <= len(data):
        length = struct.unpack(">I", data[pos : pos + 4])[0]
        kind = data[pos + 4 : pos + 8]
        chunk = data[pos + 8 : pos + 8 + length]
        if kind == b"IHDR":
            width, height = struct.unpack(">II", chunk[:8])
            bit, color = chunk[8], chunk[9]
            if bit != 8 or color not in (2, 6) or chunk[12] != 0:
                raise ValueError("unsupported png")
        elif kind == b"IDAT":
            idat += chunk
        elif kind == b"IEND":
            break
        pos += 12 + length
    if not width or not height:
        raise ValueError("png has no header")
    channels = 4 if color == 6 else 3
    raw = zlib.decompress(idat)
    stride = width * channels
    rows = []
    index = 0
    prev = bytearray(stride)

    def paeth(left, up, upper_left):
        estimate = left + up - upper_left
        distances = (
            abs(estimate - left),
            abs(estimate - up),
            abs(estimate - upper_left),
        )
        best = left
        best_distance = distances[0]
        if distances[1] < best_distance:
            best = up
            best_distance = distances[1]
        if distances[2] < best_distance:
            best = upper_left
        return best

    for _ in range(height):
        filter_ = raw[index]
        index += 1
        row = bytearray(raw[index : index + stride])
        index += stride
        if filter_ == 1:
            for x in range(stride):
                left = row[x - channels] if x >= channels else 0
                row[x] = (row[x] + left) & 255
        elif filter_ == 2:
            for x in range(stride):
                row[x] = (row[x] + prev[x]) & 255
        elif filter_ == 3:
            for x in range(stride):
                left = row[x - channels] if x >= channels else 0
                row[x] = (row[x] + ((left + prev[x]) // 2)) & 255
        elif filter_ == 4:
            for x in range(stride):
                left = row[x - channels] if x >= channels else 0
                upper_left = prev[x - channels] if x >= channels else 0
                row[x] = (row[x] + paeth(left, prev[x], upper_left)) & 255
        elif filter_ != 0:
            raise ValueError(f"png filter {filter_}")
        rgba = bytearray(width * 4)
        if channels == 4:
            rgba[:] = row
            prev = row
        else:
            for x in range(width):
                rgba[x * 4 : x * 4 + 3] = row[x * 3 : x * 3 + 3]
                rgba[x * 4 + 3] = 255
            prev = row
        rows.append(bytes(rgba))
    return width, height, rows


def is_highlight_paper(r, g, b):
    return r > 220 and 170 < g < 250 and b < 170 and (r - b) > 50 and (g - b) > 30


def is_ink(r, g, b):
    return r < 96 and g < 96 and b < 96


def highlight_band(rows):
    height = len(rows)
    width = len(rows[0]) // 4 if rows else 0
    points = []
    for y, row in enumerate(rows):
        for x in range(width):
            offset = x * 4
            if is_highlight_paper(row[offset], row[offset + 1], row[offset + 2]):
                points.append((x, y))
    if len(points) > 200_000:
        return None
    groups = _clusters(points, 14)
    best = None
    for group in groups:
        if len(group) < 40:
            continue
        xs = [p[0] for p in group]
        ys = [p[1] for p in group]
        x0, x1 = min(xs), max(xs)
        y0, y1 = min(ys), max(ys)
        band_w = x1 - x0 + 1
        band_h = y1 - y0 + 1
        if band_w < 20 or band_h < 8 or band_h > 400:
            continue
        if y1 < height * 0.08:
            continue
        dark = 0
        for y in range(y0, y1 + 1):
            row = rows[y]
            for x in range(x0, x1 + 1):
                offset = x * 4
                if is_ink(row[offset], row[offset + 1], row[offset + 2]):
                    dark += 1
        if dark < 15:
            continue
        if best is None or len(group) > best["yellow"]:
            best = {
                "yellow": len(group),
                "dark": dark,
                "x": x0,
                "y": y0,
                "w": band_w,
                "h": band_h,
            }
    return best


def _clusters(points, gap):
    parent = list(range(len(points)))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    buckets = {}
    for index, (x, y) in enumerate(points):
        buckets.setdefault((x // gap, y // gap), []).append(index)
    for index, (x, y) in enumerate(points):
        cx, cy = x // gap, y // gap
        for nx in range(cx - 1, cx + 2):
            for ny in range(cy - 1, cy + 2):
                for other in buckets.get((nx, ny), []):
                    x2, y2 = points[other]
                    if abs(x - x2) <= gap and abs(y - y2) <= gap:
                        ra, rb = find(index), find(other)
                        if ra != rb:
                            parent[rb] = ra
    groups = {}
    for index, point in enumerate(points):
        groups.setdefault(find(index), []).append(point)
    return list(groups.values())


def encode_png(width, height, rgba):
    raw = bytearray()
    stride = width * 4
    for y in range(height):
        raw.append(0)
        raw.extend(rgba[y * stride : (y + 1) * stride])

    def chunk(kind, body):
        return (
            struct.pack(">I", len(body))
            + kind
            + body
            + struct.pack(">I", zlib.crc32(kind + body) & 0xFFFFFFFF)
        )

    header = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", zlib.compress(bytes(raw)))
        + chunk(b"IEND", b"")
    )


def page_centered(body):
    try:
        x = float(body.get("page_x"))
        width = float(body.get("page_w"))
        stage = float(body.get("stage_w"))
    except (TypeError, ValueError):
        return False
    if width <= 0 or stage <= 0 or x + width > stage + 2.0:
        return False
    bar = float(body.get("bar_w") or 0)
    if bar > 1.0:
        return content_centered(body)
    return abs((x + width / 2.0) - (stage / 2.0)) <= 2.0


def content_centered(body, tol=0.5):
    try:
        x = float(body.get("page_x"))
        width = float(body.get("page_w"))
        stage = float(body.get("stage_w"))
        bar = float(body.get("bar_w"))
    except (TypeError, ValueError):
        return False
    if width <= 0 or stage <= bar or bar <= 1.0:
        return False
    page_mid = x + width / 2.0
    area_mid = bar + (stage - bar) / 2.0
    return abs(page_mid - area_mid) <= tol and x + 0.5 >= bar and x + width <= stage + 0.5


def near_white(red, green, blue):
    return abs(red - 255) <= 1 and abs(green - 255) <= 1 and abs(blue - 255) <= 1


def field_gray(red, green, blue):
    return abs(red - 228) <= 2 and abs(green - 228) <= 2 and abs(blue - 230) <= 2


def card_insets(body):
    try:
        stage_w = float(body["stage_w"])
        stage_h = float(body["stage_h"])
        bar = float(body.get("bar_w") or 0)
        top = float(body.get("top") or CHROME_TOP)
        card_x = float(body["card_x"])
        card_y = float(body["card_y"])
        card_w = float(body["card_w"])
        card_h = float(body["card_h"])
    except (TypeError, ValueError, KeyError):
        return None
    left_edge = bar if bar > 1.0 else 0.0
    return (
        card_x - left_edge,
        card_y - top,
        stage_w - (card_x + card_w),
        stage_h - (card_y + card_h),
    )


def card_bounds_detail(body):
    if not isinstance(body, dict):
        return False, "no chrome"
    if body.get("fullscreen") or body.get("immersive"):
        return False, "not the windowed card"
    if abs(float(body.get("card_inset") or -1) - 6.0) > 0.01:
        return False, f"card_inset {body.get('card_inset')}"
    sides = card_insets(body)
    if sides is None:
        return False, "card rect missing"
    names = ("left", "top", "right", "bottom")
    bad = [f"{name} {value:.2f}" for name, value in zip(names, sides) if abs(value - 6.0) > 0.5]
    if bad:
        return False, "inset " + " ".join(bad)
    return True, "inset " + " ".join(f"{value:.2f}" for value in sides)


def immersive_edge_detail(body):
    if not isinstance(body, dict) or body.get("immersive") is not True:
        return False, "not immersive"
    inset = body.get("card_inset")
    if not isinstance(inset, (int, float)) or abs(float(inset)) > 0.01:
        return False, f"card_inset {body.get('card_inset')}"
    try:
        stage_w = float(body["stage_w"])
        stage_h = float(body["stage_h"])
        card_x = float(body["card_x"])
        card_y = float(body["card_y"])
        card_w = float(body["card_w"])
        card_h = float(body["card_h"])
        page_x = float(body["page_x"])
        page_y = float(body["page_y"])
        page_w = float(body["page_w"])
        page_h = float(body["page_h"])
    except (TypeError, ValueError, KeyError):
        return False, "immersive rect missing"
    sides = (
        card_x,
        card_y,
        stage_w - (card_x + card_w),
        stage_h - (card_y + card_h),
    )
    if any(abs(value) > 0.5 for value in sides):
        return False, "card inset " + " ".join(f"{value:.2f}" for value in sides)
    touches = (
        page_y <= 0.5
        or page_x <= 0.5
        or abs((page_x + page_w) - stage_w) <= 0.5
        or abs((page_y + page_h) - stage_h) <= 0.5
    )
    if not touches:
        return False, f"page {page_x:.1f},{page_y:.1f} {page_w:.1f}x{page_h:.1f} floats inside the stage"
    return True, f"page {page_x:.1f},{page_y:.1f} {page_w:.1f}x{page_h:.1f}"


def immersive_button_detail(body):
    if not isinstance(body, dict) or body.get("immersive_button") is not True:
        return False, "immersive button missing"
    frame = body.get("immersive_frame")
    if not isinstance(frame, dict):
        return False, "immersive frame missing"
    try:
        right = float(frame["x"]) + float(frame["w"])
        toolbar = float(body["toolbar_max_x"])
        stage = float(body["stage_w"])
    except (TypeError, ValueError, KeyError):
        return False, "immersive frame incomplete"
    if not right == right or not toolbar == toolbar:
        return False, "immersive frame was not measured"
    if abs(right - toolbar) > 0.5:
        return False, f"button right {right:.1f} toolbar {toolbar:.1f}"
    if right < stage * 0.5:
        return False, f"button at {right:.1f} of stage {stage:.1f}"
    return True, f"button right {right:.1f} toolbar {toolbar:.1f}"


def png_rgb(rows, width, x, y):
    if y < 0 or y >= len(rows) or x < 0 or x >= width:
        return None
    channels = len(rows[0]) // width
    offset = x * channels
    row = rows[y]
    if offset + 2 >= len(row):
        return None
    return row[offset], row[offset + 1], row[offset + 2]


def stage_scale(width, body):
    stage = float(body.get("stage_w") or 0)
    if stage <= 0 or width <= 0:
        return None
    return width / stage


def card_gutter_detail(png, body):
    width, _height, rows = decode_png_rows(png)
    scale = stage_scale(width, body)
    sides = card_insets(body) if isinstance(body, dict) else None
    if scale is None or sides is None:
        return False, "gutter shot missing"
    bar = float(body.get("bar_w") or 0)
    top = float(body.get("top") or CHROME_TOP)
    gutter = png_rgb(rows, width, int(round((bar + 3.0) * scale)), int(round((top + 3.0) * scale)))
    if gutter is None or not field_gray(*gutter):
        return False, f"top gutter {gutter}"
    try:
        card_x = float(body["card_x"])
        card_y = float(body["card_y"])
        card_h = float(body["card_h"])
        page_x = float(body["page_x"])
    except (TypeError, ValueError, KeyError):
        return False, "card shot missing"
    if page_x <= card_x + 4.0:
        return True, f"gutter {gutter}"
    letter = png_rgb(
        rows,
        width,
        int(round((card_x + 2.0) * scale)),
        int(round((card_y + card_h / 2.0) * scale)),
    )
    if letter is None or not near_white(*letter):
        return False, f"letterbox {letter}"
    return True, f"gutter {gutter} letterbox {letter}"


def gray_outside_page(png, body):
    width, height, rows = decode_png_rows(png)
    scale = stage_scale(width, body)
    if scale is None:
        raise ValueError("stage width missing")
    page_x = float(body["page_x"])
    page_y = float(body["page_y"])
    page_w = float(body["page_w"])
    page_h = float(body["page_h"])
    left = int(round(page_x * scale))
    top = int(round(page_y * scale))
    right = int(round((page_x + page_w) * scale))
    bottom = int(round((page_y + page_h) * scale))
    count = 0
    for y in range(height):
        if top <= y < bottom:
            spans = ((0, max(0, left)), (min(width, right), width))
        else:
            spans = ((0, width),)
        for x0, x1 in spans:
            for x in range(x0, x1):
                pixel = png_rgb(rows, width, x, y)
                if pixel is not None and field_gray(*pixel):
                    count += 1
    return count


def band_white(width, rows):
    """The header, the footer, the side margins, and the text ground are #ffffff ±1.

    Glyphs are skipped. A cream band in any of those regions fails, including
    when the text block itself stays white.
    The left bar is #E4E4E6, so those samples start to its right.
    The 6pt card gutter is the same gray. It is allowed outside the text block.
    """
    width, rows = past_bar(width, rows)
    height = len(rows)
    if not rows or width < 40 or height < 40:
        return False, "shot too small"
    channels = len(rows[0]) // width

    def px(x, y):
        offset = x * channels
        row = rows[y]
        return row[offset], row[offset + 1], row[offset + 2]

    def ink(x, y):
        red, green, blue = px(x, y)
        return max(red, green, blue) < 160

    def glyph_edge(x, y):
        if ink(x, y):
            return True
        for dy in (-2, -1, 0, 1, 2):
            yy = y + dy
            if yy < 0 or yy >= height:
                continue
            for dx in (-2, -1, 0, 1, 2):
                xx = x + dx
                if 0 <= xx < width and ink(xx, yy):
                    return True
        return False

    regions = {
        "header": (int(width * 0.15), int(width * 0.85), int(height * 0.02), int(height * 0.12)),
        "footer": (int(width * 0.15), int(width * 0.85), int(height * 0.92), int(height * 0.985)),
        "margin-left": (int(width * 0.02), int(width * 0.08), int(height * 0.25), int(height * 0.75)),
        "margin-right": (int(width * 0.92), int(width * 0.98), int(height * 0.25), int(height * 0.75)),
        "text": (int(width * 0.35), int(width * 0.65), int(height * 0.32), int(height * 0.68)),
    }
    problems = []
    for name, (x0, x1, y0, y1) in regions.items():
        seen = 0
        bad = None
        for y in range(max(0, y0), min(height, y1), 2):
            for x in range(max(0, x0), min(width, x1), 2):
                if name in ("text", "footer") and glyph_edge(x, y):
                    continue
                red, green, blue = px(x, y)
                if (
                    name == "text"
                    and red >= 200
                    and green >= 160
                    and blue <= 210
                    and red >= blue + 30
                    and green >= blue + 20
                ):
                    continue
                if (
                    name == "footer"
                    and max(red, green, blue) - min(red, green, blue) <= 12
                    and max(red, green, blue) < 230
                ):
                    continue
                if name != "text" and field_gray(red, green, blue):
                    continue
                seen += 1
                if not near_white(red, green, blue):
                    bad = (x, y, red, green, blue)
                    break
            if bad:
                break
        if bad:
            x, y, red, green, blue = bad
            problems.append(f"{name} {red},{green},{blue} at {x},{y}")
        elif seen < 8:
            problems.append(f"{name} empty")
    if problems:
        return False, "; ".join(problems)
    return True, "header, footer, margins, text #ffffff"


def content_ink(path):
    width, height, rows = decode_png_rows(path)
    channels = len(rows[0]) // width
    ink = 0
    for y in range(int(height * 0.15), int(height * 0.85), 3):
        row = rows[y]
        for x in range(0, width, 3):
            offset = x * channels
            if row[offset] < 80 and row[offset + 1] < 80 and row[offset + 2] < 80:
                ink += 1
    return ink


def vertical_rule(path):
    width, height, rows = decode_png_rows(path)
    channels = len(rows[0]) // width

    def px(x, y):
        offset = x * channels
        row = rows[y]
        return row[offset], row[offset + 1], row[offset + 2]

    top = int(height * 0.18)
    bot = int(height * 0.82)
    span = max(1, (bot - top) // 2)
    for x in range(6, width - 6, 2):
        streak = 0
        best = 0
        for y in range(top, bot, 2):
            red, green, blue = px(x, y)
            left = px(x - 4, y)
            right = px(x + 4, y)
            if max(red, green, blue) < 70 and min(left) > 180 and min(right) > 180:
                streak += 1
                best = max(best, streak)
            else:
                streak = 0
        if best > span // 6:
            return x
    return None


def flat_text(value):
    return re.sub(r"[\s\u00a0\u202f\u2007\u2009\u200a]+", " ", value or "")


def duplicate_blocks(plain):
    lines = [flat_text(line).strip() for line in (plain or "").splitlines()]
    lines = [line for line in lines if line]
    return [line for previous, line in zip(lines, lines[1:]) if line == previous]


def missing_source_text(plain, book):
    text = flat_text(plain)
    if book in ("pride", "styled", "plain-en", "publisher"):
        return [phrase for phrase in ("My dear Mr. Bennet", "Mr. Bennet replied", "Mrs. Long") if phrase not in text]
    if book in ("zhaohua", "plain-zh"):
        collapsed = re.sub(r"\s+", "", text)
        needle = "范愛農" if book == "zhaohua" else "客店"
        return [] if needle in collapsed else [needle]
    return []


def ratio_within(width, height, want_w, want_h):
    if height <= 0 or want_h <= 0:
        return False
    got = width / height
    want = want_w / want_h
    return abs(got - want) / want <= 0.01


