def loadavg():
    try:
        one, five, fifteen = os.getloadavg()
    except OSError:
        return "unknown"
    return f"{one:.2f} {five:.2f} {fifteen:.2f}"


def nsh_version():
    try:
        proc = subprocess.run(["nsh", "--version"], capture_output=True, text=True)
    except FileNotFoundError:
        return ""
    return (proc.stdout or proc.stderr or "").strip()


def nsh_is_pinned(version):
    return re.match(r"^nsh 0\.4\.0(?:\s|$)", version) is not None


def spike_pids():
    proc = subprocess.run(["pgrep", "-x", "spike-shell"], capture_output=True, text=True)
    if proc.returncode != 0:
        return []
    return [int(line) for line in proc.stdout.split() if line.strip()]


def forbidden_crates():
    hits = []
    lock = SPIKES / "Cargo.lock"
    names = re.findall(r'^name = "([^"]+)"', lock.read_text(), re.M)
    for name in names:
        if name in ("epub", "mupdf"):
            hits.append(f"Cargo.lock package {name}")
    for path in SPIKES.rglob("Cargo.toml"):
        if "target" in path.parts:
            continue
        text = path.read_text()
        for banned in ("epub", "mupdf"):
            if re.search(rf"(?m)^\s*{banned}\s*=", text):
                hits.append(f"{path.relative_to(ROOT)} depends on {banned}")
    return hits


def nsh_pins():
    text = (SHELL / "Cargo.toml").read_text()
    missing = []
    for crate in ("nsh-core", "nsh-base", "nsh-platform-macos"):
        if f'{crate} = "=0.4.0"' not in text and f'{crate} = {{ version = "=0.4.0"' not in text:
            missing.append(crate)
    return missing


def pdfium_dylib():
    if PDFIUM.is_file():
        return PDFIUM
    return PDFIUM / "libpdfium.dylib"


def doctor():
    rows = []
    version = nsh_version()
    if nsh_is_pinned(version):
        rows.append(check("nsh-pin", "reading-bars", "doctor", "pass", version))
    else:
        rows.append(
            check(
                "nsh-pin",
                "reading-bars",
                "doctor",
                "fail",
                f"want nsh {NSH_VERSION}, got {version or 'no nsh'}",
            )
        )
    pins = nsh_pins()
    if pins:
        rows.append(
            check(
                "nsh-cargo-pin",
                "reading-bars",
                "doctor",
                "fail",
                "Cargo.toml is missing =0.4.0 for " + ", ".join(pins),
            )
        )
    else:
        rows.append(
            check(
                "nsh-cargo-pin",
                "reading-bars",
                "doctor",
                "pass",
                "nsh-core, nsh-base, and nsh-platform-macos are =0.4.0",
            )
        )
    missing = [str(path) for path in (GPT3, PRIDE, pdfium_dylib()) if not path.exists()]
    if missing:
        rows.append(
            check(
                "fixtures",
                "open-a-pdf",
                "doctor",
                "fail",
                "missing " + ", ".join(missing) + ". spikes/fetch-fixtures.sh can fetch them.",
            )
        )
    else:
        rows.append(
            check(
                "fixtures",
                "open-a-pdf",
                "doctor",
                "pass",
                f"gpt3, pride, and libpdfium are present under {FIXTURES} and {PDFIUM}",
            )
        )
    banned = forbidden_crates()
    if banned:
        rows.append(check("no-agpl-gpl", "reading-bars", "doctor", "fail", "; ".join(banned)))
    else:
        rows.append(
            check(
                "no-agpl-gpl",
                "reading-bars",
                "doctor",
                "pass",
                "Cargo.lock has neither the epub crate nor mupdf",
            )
        )
    pids = spike_pids()
    if pids:
        rows.append(
            check(
                "spike-shell-free",
                "open-a-pdf",
                "doctor",
                "fail",
                "spike-shell is already running as pid "
                + ", ".join(str(pid) for pid in pids)
                + ". Quit that process. This run will not kill it.",
            )
        )
    else:
        rows.append(
            check(
                "spike-shell-free",
                "open-a-pdf",
                "doctor",
                "pass",
                "no spike-shell process is running",
            )
        )
    if sys.platform != "darwin":
        rows.append(check("macos", "reading-bars", "doctor", "fail", sys.platform))
    else:
        rows.append(check("macos", "reading-bars", "doctor", "pass", "darwin"))
    return rows


def cargo_bin() -> str:
    if CARGO.is_file():
        return str(CARGO)
    return "cargo"


def cargo_target_dir() -> Path:
    global _TARGET_DIR
    if _TARGET_DIR is None:
        proc = subprocess.run(
            [cargo_bin(), "metadata", "--no-deps", "--format-version", "1"],
            cwd=SPIKES,
            capture_output=True,
            text=True,
            check=True,
        )
        _TARGET_DIR = Path(json.loads(proc.stdout)["target_directory"])
    return _TARGET_DIR


def release_bin(name: str) -> Path:
    return cargo_target_dir() / "release" / name


def build(log_path):
    logs = []
    for package in ("spike-shell", "spike-measure"):
        proc = subprocess.run(
            [cargo_bin(), "build", "--release", "-p", package],
            cwd=SPIKES,
            capture_output=True,
            text=True,
        )
        logs.append(proc.stdout + "\n" + proc.stderr)
        if proc.returncode != 0:
            log_path.write_text("\n".join(logs))
            tail = "\n".join((proc.stderr or proc.stdout).splitlines()[-20:])
            return check("build", "open-a-pdf", "doctor", "fail", tail or f"cargo build -p {package} failed")
    log_path.write_text("\n".join(logs))
    return check(
        "build",
        "open-a-pdf",
        "doctor",
        "pass",
        "release spike-shell and spike-measure, built separately so taffy's calc feature stays off the shell",
    )


def nsh_cases(junit, proc):
    if not junit.exists():
        return None, "nsh test wrote no junit"
    try:
        tree = ElementTree.parse(junit)
    except ElementTree.ParseError as exc:
        return None, f"junit {exc}"
    by_name = {}
    for case in tree.iter("testcase"):
        name = case.attrib.get("name", "")
        failure = case.find("failure")
        error = case.find("error")
        skipped = case.find("skipped")
        node = failure if failure is not None else error
        if skipped is not None:
            by_name[name] = skipped.attrib.get("message") or "skipped"
        elif node is None and proc.returncode != 0:
            by_name[name] = f"nsh test exited {proc.returncode}"
        else:
            by_name[name] = None if node is None else (node.attrib.get("message") or node.text or "failed")
    return by_name, None


def invoke_nsh(script, env, junit, log_path):
    junit.unlink(missing_ok=True)
    proc = subprocess.run(
        ["nsh", "test", script, "--junit", str(junit)],
        cwd=SHELL,
        capture_output=True,
        text=True,
        timeout=900,
        env=env,
    )
    log_path.write_text(proc.stdout + "\n" + proc.stderr)
    return nsh_cases(junit, proc)


def run_nsh(out):
    apple = ROOT / "spikes" / "library" / "fixtures" / "apple"
    calibre = ROOT / "spikes" / "library" / "fixtures" / "calibre"
    env = os.environ.copy()
    for key in (
        "SPIKE_ONBOARDING",
        "SUPERREADER_OPEN_KIND",
        "SUPERREADER_OPEN_PATH",
        "SUPERREADER_OPEN_TITLE",
    ):
        env.pop(key, None)
    env["SPIKE_LANG"] = "en"
    env["SUPERREADER_LIBRARY"] = str(apple)
    env["SUPERREADER_CALIBRE"] = str(calibre)
    parsed, err = invoke_nsh(
        "shell.test.tsx",
        env,
        out / "nsh-junit.xml",
        out / "nsh-test.log",
    )
    by_name = {}
    denied_name = "denied apple import turns the button into a folder picker"
    if err is not None:
        for name in NSH_CASES:
            if name != denied_name:
                by_name[name] = err
    else:
        by_name.update(parsed)
    deny = out / "deny-apple"
    if deny.exists():
        os.chmod(deny, 0o755)
        shutil.rmtree(deny)
    deny.mkdir()
    os.chmod(deny, 0o000)
    deny_env = os.environ.copy()
    for key in (
        "SPIKE_ONBOARDING",
        "SUPERREADER_CALIBRE",
        "SUPERREADER_OPEN_KIND",
        "SUPERREADER_OPEN_PATH",
        "SUPERREADER_OPEN_TITLE",
    ):
        deny_env.pop(key, None)
    deny_env["SPIKE_LANG"] = "en"
    deny_env["SUPERREADER_LIBRARY"] = str(deny)
    try:
        denied, deny_err = invoke_nsh(
            "shell.access.test.tsx",
            deny_env,
            out / "nsh-access-junit.xml",
            out / "nsh-access.log",
        )
    finally:
        os.chmod(deny, 0o755)
        shutil.rmtree(deny, ignore_errors=True)
    if deny_err is not None:
        by_name[denied_name] = deny_err
    else:
        by_name.update(denied)
    rows = []
    for name, (check_id, feature) in NSH_CASES.items():
        proof = "nsh-access-junit.xml" if name == denied_name else "nsh-junit.xml"
        if name not in by_name:
            rows.append(check(check_id, feature, "nsh", "fail", f"nsh test did not run {name}"))
        elif by_name[name] is None:
            rows.append(check(check_id, feature, "nsh", "pass", name, proof))
        else:
            rows.append(check(check_id, feature, "nsh", "fail", by_name[name], proof))
    return rows


def child_env(extra):
    env = os.environ.copy()
    for key in (
        "SPIKE_MODE",
        "SPIKE_SELECT",
        "SPIKE_DRAG",
        "SPIKE_SCALE",
        "SPIKE_TURN",
        "SPIKE_RELOAD",
        "SPIKE_BOOK",
        "SPIKE_ENGINE",
        "SPIKE_NEEDLE",
        "SPIKE_READING",
        "SPIKE_PLAY",
        "SPIKE_AT",
        "SPIKE_JUSTIFY",
        "SPIKE_NEXT",
        "SPIKE_CHROME",
        "SPIKE_CHROME_SHOW",
        "SPIKE_FULLSCREEN",
        "SPIKE_BOLD_PROBES",
        "SPIKE_LIGHTS",
        "SPIKE_APPEARANCE",
        "SPIKE_WINDOW",
        "SPIKE_ICON",
        "SPIKE_ONBOARDING",
        "SPIKE_LANG",
        "SUPERREADER_LIBRARY",
        "SUPERREADER_CALIBRE",
        "SUPERREADER_OPEN_KIND",
        "SUPERREADER_OPEN_PATH",
        "SUPERREADER_OPEN_TITLE",
    ):
        env.pop(key, None)
    env.update(extra)
    return env


def stop(proc):
    if proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=3)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait(timeout=3)


def ax_names(pid):
    script = f'''
tell application "System Events"
  if not (exists (first process whose unix id is {pid})) then
    return "NO_PROCESS"
  end if
  tell (first process whose unix id is {pid})
    set out to ""
    repeat with w in windows
      set out to out & "WIN " & (name of w as text) & linefeed
      set elems to entire contents of w
      repeat with e in elems
        try
          set r to role of e as text
          set n to name of e as text
          -- A pressable view is an AXButton whose title is empty. Its
          -- accessibility label is the description, which is the string
          -- the shelf checks look for.
          if n is "missing value" or n is "" then
            if r is "AXButton" then
              set n to description of e as text
            end if
          end if
          if n is not "missing value" and n is not "" and n is not "button" then
            set out to out & r & tab & n & linefeed
          end if
        end try
      end repeat
    end repeat
    return out
  end tell
end tell
'''
    proc = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if proc.returncode != 0:
        return [], (proc.stderr or proc.stdout or "osascript failed").strip()
    names = []
    for line in proc.stdout.splitlines():
        if "\t" in line:
            _role, name = line.split("\t", 1)
            names.append(name)
    return names, proc.stdout


def compile_window_id(out):
    source = out / "window-id.swift"
    source.write_text(
        """
import CoreGraphics
import AppKit
guard CommandLine.arguments.count > 1, let pid = Int32(CommandLine.arguments[1]) else {
  fputs("pid\\n", stderr)
  exit(2)
}
let info = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as! [[String: Any]]
var bestArea: CGFloat = 0
var best = ""
for window in info {
  let owner = window[kCGWindowOwnerPID as String] as? Int32 ?? -1
  let layer = window[kCGWindowLayer as String] as? Int ?? -1
  guard owner == pid, layer == 0, let dict = window[kCGWindowBounds as String] as? [String: CGFloat] else { continue }
  let width = dict["Width"] ?? 0
  let height = dict["Height"] ?? 0
  let area = width * height
  if area <= bestArea { continue }
  bestArea = area
  let number = window[kCGWindowNumber as String] as? Int ?? 0
  let screen = NSScreen.main
  let visible = screen?.visibleFrame ?? .zero
  let scale = screen?.backingScaleFactor ?? 1
  let screenH = screen?.frame.height ?? 0
  let x = dict["X"] ?? 0
  let y = dict["Y"] ?? 0
  best = "\\(number) \\(width) \\(height) \\(visible.width) \\(visible.height) \\(scale) \\(screenH) \\(x) \\(y)"
}
if best.isEmpty { exit(1) }
print(best)
exit(0)
"""
    )
    binary = out / "window-id"
    proc = subprocess.run(
        ["swiftc", "-O", "-o", str(binary), str(source)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "swiftc failed")
    return binary


def window_metrics(tool, pid):
    proc = subprocess.run([str(tool), str(pid)], capture_output=True, text=True)
    if proc.returncode != 0:
        return None
    parts = proc.stdout.split()
    if len(parts) < 7:
        return None
    try:
        metrics = {
            "id": int(float(parts[0])),
            "w": float(parts[1]),
            "h": float(parts[2]),
            "vis_w": float(parts[3]),
            "vis_h": float(parts[4]),
            "scale": float(parts[5]),
            "screen_h": float(parts[6]),
        }
        if len(parts) >= 9:
            metrics["x"] = float(parts[7])
            metrics["y"] = float(parts[8])
        return metrics
    except ValueError:
        return None


def window_id(tool, pid):
    metrics = window_metrics(tool, pid)
    if metrics is None:
        return None
    return metrics["id"]


def capture(window, path):
    proc = subprocess.run(
        ["screencapture", "-l", str(window), "-o", str(path)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0 or not path.exists():
        raise RuntimeError(proc.stderr or proc.stdout or "screencapture failed")


def anchor_phrase(body):
    if not isinstance(body, dict):
        return ""
    anchor = body.get("anchor")
    if not isinstance(anchor, dict):
        return ""
    inner = anchor.get("Epub") or anchor.get("Pdf") or anchor
    if not isinstance(inner, dict):
        return ""
    return inner.get("text") or ""


def webkit_body(started):
    if not WEBKIT_JSON.exists() or WEBKIT_JSON.stat().st_mtime + 0.05 < started:
        return None
    try:
        return json.loads(WEBKIT_JSON.read_text())
    except json.JSONDecodeError:
        return None


def compile_ocr(out):
    source = out / "ocr.swift"
    source.write_text(
        """
import Foundation
import Vision
import AppKit

let path = CommandLine.arguments[1]
guard let image = NSImage(contentsOfFile: path),
      let tiff = image.tiffRepresentation,
      let rep = NSBitmapImageRep(data: tiff),
      let cg = rep.cgImage else {
  fputs("no image\\n", stderr)
  exit(2)
}
let request = VNRecognizeTextRequest()
request.recognitionLevel = .accurate
request.usesLanguageCorrection = false
request.recognitionLanguages = ["zh-Hans", "en-US"]
let handler = VNImageRequestHandler(cgImage: cg, options: [:])
try handler.perform([request])
for line in (request.results ?? []).compactMap({ $0.topCandidates(1).first?.string }) {
  print(line)
}
"""
    )
    binary = out / "ocr"
    proc = subprocess.run(
        ["swiftc", "-O", "-o", str(binary), str(source)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "ocr swiftc failed")
    return binary


def ocr_lines(tool, png):
    proc = subprocess.run([str(tool), str(png)], capture_output=True, text=True)
    if proc.returncode != 0:
        return []
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


def launch(out, name, env, ready, timeout, watch=None, binary=None):
    log = out / f"{name}.log"
    handle = log.open("w")
    proc = subprocess.Popen(
        [str(binary or release_bin("spike-shell"))],
        env=env,
        stdout=handle,
        stderr=subprocess.STDOUT,
        cwd=SPIKES,
    )
    handle.close()
    started = time.time()
    names = []
    dump = ""
    try:
        deadline = time.time() + timeout
        while time.time() < deadline:
            if proc.poll() is not None:
                break
            names, dump = ax_names(proc.pid)
            if ready(names) or (watch and watch(started)):
                break
            time.sleep(0.4)
        else:
            names, dump = ax_names(proc.pid)
        return {
            "pid": proc.pid,
            "names": names,
            "dump": dump,
            "started": started,
            "alive": proc.poll() is None,
            "proc": proc,
        }
    except BaseException:
        stop(proc)
        raise


def finish_launch(state, handle_close=True):
    stop(state["proc"])


def page_numbers(names):
    return [name for name in names if PAGE_NO.fullmatch(name)]


def run_windows(out, window_tool, ocr_tool):
    rows = []
    pdf_bands = {}
    shots = {
        "pdf-highlight-1x": {"SPIKE_DRAG": "1"},
        "pdf-highlight-2x": {"SPIKE_DRAG": "1", "SPIKE_SCALE": "zoom-2x"},
        "epub-pride": {"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1", "SPIKE_RELOAD": "1"},
        "epub-turned": {"SPIKE_MODE": "webkit", "SPIKE_TURN": "1"},
    }
    ready = {
        "pdf-highlight-1x": lambda names: any("Few-Shot Learners" in name for name in names)
        and any(PDF_LEFT.fullmatch(name) for name in names),
        "pdf-highlight-2x": lambda names: any("Few-Shot Learners" in name for name in names)
        and any(PDF_LEFT.fullmatch(name) for name in names),
        "epub-pride": lambda names: False,
        "epub-turned": lambda names: False,
    }
    watch = {
        "epub-pride": lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("pages"), list)
            and len(body["pages"]) == 2
            and body["pages"][1] > 1
            and "truth universally acknowledged" in anchor_phrase(body)
        ),
        "epub-turned": lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("pages"), list)
            and len(body["pages"]) == 2
            and body["pages"][0] == 2
        ),
    }
    states = {}
    try:
        for name, env in shots.items():
            if name == "epub-pride":
                (out / "epub-anchor.json").unlink(missing_ok=True)
            state = launch(
                out,
                name,
                child_env(env),
                ready[name],
                20 if name.startswith("epub") else 12,
                watch.get(name),
            )
            states[name] = state
            (out / f"{name}-ax.txt").write_text(state["dump"])
            fresh_anchor = (
                WEBKIT_JSON.exists() and WEBKIT_JSON.stat().st_mtime + 0.05 >= state["started"]
            )
            if name == "epub-pride" and fresh_anchor:
                shutil.copyfile(WEBKIT_JSON, out / "epub-anchor.json")
            wid = window_id(window_tool, state["pid"]) if state["alive"] else None
            png = out / f"{name}.png"
            png.unlink(missing_ok=True)
            if wid:
                time.sleep(0.8)
                capture(wid, png)
            state["png"] = png.name if png.exists() else None
            state["window"] = wid
            if name.startswith("epub") and state["png"]:
                state["names"] = ocr_lines(ocr_tool, out / state["png"])
                (out / f"{name}-ocr.txt").write_text("\n".join(state["names"]) + "\n")
    finally:
        for state in states.values():
            finish_launch(state)

    for name in shots:
        state = states.get(name)
        if state is None:
            continue
        if name.startswith("pdf-highlight") and state.get("png"):
            _w, _h, rows_px = decode_png_rows(out / state["png"])
            pdf_bands[name] = highlight_band(rows_px)

    pdf = states["pdf-highlight-1x"]
    names = pdf["names"]
    title_ok = any(name == "Language Models are Few-Shot Learners" for name in names)
    rows.append(
        check(
            "pdf-title",
            "open-a-pdf",
            "window",
            "pass" if title_ok else "fail",
            "toolbar title " + ("is the paper" if title_ok else "was " + ", ".join(names[:6])),
            pdf.get("png"),
        )
    )
    numbers = page_numbers(names)
    left = next((name for name in names if PDF_LEFT.fullmatch(name)), "")
    footer_ok = len(numbers) == 1 and bool(left)
    rows.append(
        check(
            "pdf-footer-nm",
            "open-a-pdf",
            "window",
            "pass" if footer_ok else "fail",
            f"footer {numbers} and {left or 'no pages-left text'}",
            pdf.get("png"),
        )
    )
    band = pdf_bands.get("pdf-highlight-1x")
    rows.append(
        check(
            "pdf-highlight-ink",
            "open-a-pdf",
            "window",
            "pass" if band else "fail",
            "no yellow band with ink" if not band else f"band {band['w']}x{band['h']} yellow {band['yellow']} ink {band['dark']}",
            pdf.get("png"),
        )
    )
    zoom = pdf_bands.get("pdf-highlight-2x")
    png2 = states["pdf-highlight-2x"].get("png")
    rows.append(
        check(
            "pdf-highlight-ink-zoom",
            "reading-bars",
            "window",
            "pass" if zoom else "fail",
            "no yellow band with ink after zoom-2x" if not zoom else f"band {zoom['w']}x{zoom['h']} yellow {zoom['yellow']} ink {zoom['dark']}",
            png2,
        )
    )
    if band and zoom and band["h"] > 0 and zoom["h"] >= band["h"] * 1.5:
        scale_status = "pass"
        scale_detail = f"zoom band height {zoom['h']} against retina band height {band['h']}"
    else:
        scale_status = "fail"
        scale_detail = f"zoom band {zoom} retina band {band}"
    rows.append(
        check(
            "pdf-highlight-zoom-scale",
            "reading-bars",
            "window",
            scale_status,
            scale_detail,
            png2,
        )
    )

    epub = states["epub-pride"]
    epub_names = epub["names"]
    saved_title = ""
    anchor_file = out / "epub-anchor.json"
    if anchor_file.exists():
        try:
            saved_title = json.loads(anchor_file.read_text()).get("title") or ""
        except json.JSONDecodeError:
            saved_title = ""
    epub_title = any("Pride" in name for name in epub_names) or "Pride" in saved_title
    rows.append(
        check(
            "epub-title",
            "read-an-epub",
            "window",
            "pass" if epub_title else "fail",
            saved_title or "titles were " + ", ".join(epub_names[:6]),
            epub.get("png"),
        )
    )
    epub_numbers = [name for name in epub_names if EPUB_PAGE.fullmatch(name)]
    chapter = next((name for name in epub_names if EPUB_LEFT.fullmatch(name)), "")
    rows.append(
        check(
            "epub-footer-nm",
            "read-an-epub",
            "window",
            "pass" if len(epub_numbers) == 1 else "fail",
            f"footer {epub_numbers}",
            epub.get("png"),
        )
    )
    rows.append(
        check(
            "epub-pages-left-in-chapter",
            "read-an-epub",
            "window",
            "pass" if chapter else "fail",
            chapter or "footer has no pages-left-in-chapter text",
            epub.get("png"),
        )
    )
    single = len(numbers) == 1 and len(epub_numbers) == 1
    rows.append(
        check(
            "single-page",
            "reading-bars",
            "window",
            "pass" if single else "fail",
            f"pdf page numbers {numbers}, epub page numbers {epub_numbers}",
            epub.get("png"),
        )
    )
    if epub.get("png"):
        _w, _h, epub_rows = decode_png_rows(out / epub["png"])
        epub_band = highlight_band(epub_rows)
    else:
        epub_band = None
    anchor_path = out / "epub-anchor.json"
    anchor_text = ""
    if anchor_path.exists():
        try:
            anchor_text = anchor_phrase(json.loads(anchor_path.read_text()))
        except json.JSONDecodeError:
            anchor_text = ""
    phrase = "truth universally acknowledged"
    anchor_ok = phrase in anchor_text and epub_band is not None
    rows.append(
        check(
            "epub-highlight-on-sentence",
            "read-an-epub",
            "window",
            "pass" if anchor_ok else "fail",
            f"anchor {anchor_text!r}, band {epub_band}",
            epub.get("png"),
        )
    )
    turn = states["epub-turned"]
    turned = any(name.startswith("2/") and EPUB_PAGE.fullmatch(name) for name in turn["names"])
    rows.append(
        check(
            "epub-turn",
            "read-an-epub",
            "window",
            "pass" if turned else "fail",
            "page " + ", ".join(name for name in turn["names"] if EPUB_PAGE.fullmatch(name)) or "missing",
            turn.get("png"),
        )
    )
    if DRAG_TXT.exists():
        shutil.copyfile(DRAG_TXT, out / "pdf-drag.txt")
    return rows


def capture_video(window, path, seconds):
    path.unlink(missing_ok=True)
    proc = subprocess.run(
        ["screencapture", "-l", str(window), "-V", str(seconds), "-o", str(path)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0 or not path.exists() or path.stat().st_size < 1000:
        raise RuntimeError(proc.stderr or proc.stdout or "screencapture video failed")


def chapter_ready(started, book):
    body = webkit_body(started)
    if not isinstance(body, dict):
        return False
    pages = body.get("pages")
    href = str(body.get("href") or "")
    if not (isinstance(pages, list) and len(pages) == 2 and pages[1] > 1):
        return False
    if book == "pride":
        return "chapter-1" in href
    return "0-0" not in href and pages[0] >= 3


def write_trim(name):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text('{"trim":"%s"}\n' % name)


def read_settings():
    return SETTINGS.read_text() if SETTINGS.exists() else None


def px(value):
    if not isinstance(value, str) or not value.endswith("px"):
        return None
    try:
        return float(value[:-2])
    except ValueError:
        return None


def near(value, want, slack=1.5):
    return value is not None and abs(value - want) <= slack


def wait_json(started, pred, timeout, hold=0.7):
    # The opening frame is shorter than the settled window. A predicate that
    # matches the opening frame would otherwise score and photograph that
    # page, then the window would grow under the picture.
    deadline = time.time() + timeout
    last = None
    size = None
    since = 0.0
    found = None
    while time.time() < deadline:
        last = webkit_body(started)
        if isinstance(last, dict) and pred(last):
            now_size = (round(float(last.get("page_w") or 0), 1), round(float(last.get("page_h") or 0), 1))
            now = time.time()
            if now_size != size:
                size = now_size
                since = now
                found = last
            elif now - since >= hold:
                fresh = webkit_body(started)
                return fresh if isinstance(fresh, dict) and pred(fresh) else found
        time.sleep(0.15)
    return found if isinstance(found, dict) else (last if isinstance(last, dict) else {})


def page_shot(state, window_tool, ocr_tool, png):
    lines = []
    if state["alive"]:
        time.sleep(0.6)
        for _ in range(4):
            wid = window_id(window_tool, state["pid"])
            if not wid:
                time.sleep(0.3)
                continue
            try:
                capture(wid, png)
                break
            except RuntimeError:
                time.sleep(0.4)
        if png.exists():
            lines = ocr_lines(ocr_tool, png)
    return lines


def run_reading(out, window_tool, ocr_tool):
    rows = []
    proto = ROOT / "docs" / "prototypes" / "reading-view"
    proto.mkdir(parents=True, exist_ok=True)
    builder = ROOT / "spikes" / "epub" / "fixtures" / "build_books.py"
    built = subprocess.run(["python3", str(builder)], capture_output=True, text=True)
    if built.returncode != 0:
        rows.append(check("reading-styled", "reading-view", "window", "fail", built.stderr or built.stdout))
        return rows
    saved = read_settings()
    qualities = []
    notes = []
    gap_ratio = None
    try:
        rows.extend(default_trim_shots(out, window_tool, ocr_tool, proto))
        native_pride_shots(out, window_tool, ocr_tool)
        write_trim("32kai")
        rows.extend(pride_trims(out, window_tool, ocr_tool, proto, qualities, notes))
        gap_ratio = rows and None
        for row in rows:
            if row["id"] == "trim-32kai-pride" and "gap" in row["detail"]:
                gap_ratio = row["detail"]
        rows.extend(zhaohua_trims(out, window_tool, ocr_tool, proto, qualities, notes))
        rows.extend(style_books(out, window_tool, ocr_tool, proto, notes))
        rows.extend(plain_en_bars(out))
        rows.extend(plain_zh_bars(out))
        rows.extend(publisher_bars(out))
        rows.extend(page_ready_runs(out))
        rows.extend(fixed_book(out))
        rows.extend(slide_turn(out, window_tool, proto))
        rows.extend(layout_and_text_checks(notes))
        dirty = [
            item["name"]
            for item in qualities
            if item["tofu"] is None or item["cjk_gap"] is None or item["tofu"] or item["cjk_gap"]
        ]
        rows.append(
            check(
                "reading-text-clean",
                "reading-view",
                "window",
                "pass" if qualities and not dirty else "fail",
                "clean" if not dirty else f"tofu or a space between CJK in {dirty}",
            )
        )
    finally:
        if saved is None:
            SETTINGS.unlink(missing_ok=True)
        else:
            SETTINGS.parent.mkdir(parents=True, exist_ok=True)
            SETTINGS.write_text(saved)
    note = proto / "gap.txt"
    note.write_text((gap_ratio or "no gap ratio") + "\n")
    return rows


def default_trim_shots(out, window_tool, ocr_tool, proto):
    SETTINGS.unlink(missing_ok=True)
    want_w, want_h = TRIMS["paperback"]
    shots = (
        ("default-trim-pride", {"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}, "pride"),
        ("default-trim-zhaohua", {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "zhaohua", "SPIKE_AT": "3"}, "zhaohua"),
    )
    rows = []
    bad = []
    backgrounds = {}
    shot_paths = {}
    plains = {}
    mouse = compile_mouse(out)
    for name, env, book in shots:
        WEBKIT_JSON.unlink(missing_ok=True)
        state = launch(
            out,
            name,
            child_env(env),
            lambda names: False,
            30,
            lambda started, book=book: chapter_ready(started, book),
        )
        png = out / f"{name}.png"
        try:
            body = wait_json(
                state["started"],
                lambda item, want_w=want_w, want_h=want_h: (
                    item.get("trim") == "paperback"
                    and item.get("page_source") == "trim"
                    and ratio_within(item.get("page_w") or 0, item.get("page_h") or 0, want_w, want_h)
                    and not SETTINGS.exists()
                ),
                8,
            )
            if state["alive"]:
                metrics = window_metrics(window_tool, state["pid"])
                if metrics:
                    # Rest the pointer so the lights and the template icon fade
                    # before the paper sample.
                    park_mouse(mouse, metrics["screen_h"])
                    time.sleep(0.7)
                page_shot(state, window_tool, ocr_tool, png)
                if png.exists():
                    shutil.copyfile(png, proto / png.name)
        finally:
            finish_launch(state)
        fresh = webkit_body(state["started"]) or body
        sample = fresh.get("sample") if isinstance(fresh, dict) else None
        backgrounds[book] = css_rgb(sample.get("background") if isinstance(sample, dict) else None)
        shot_paths[book] = png
        plains[book] = fresh.get("plain") if isinstance(fresh, dict) else ""
        ratio_ok = ratio_within(fresh.get("page_w") or 0, fresh.get("page_h") or 0, want_w, want_h)
        ink = content_ink(png) if png.exists() else 0
        if not (fresh.get("trim") == "paperback" and ratio_ok and ink > 400 and not SETTINGS.exists()):
            bad.append(
                f"{book} trim {fresh.get('trim')} {fresh.get('page_w')}/{fresh.get('page_h')} ink {ink} file {SETTINGS.exists()}"
            )
    rows.append(
        check(
            "reading-default-trim",
            "reading-view",
            "window",
            "pass" if not bad else "fail",
            "missing settings file opens at paperback" if not bad else "; ".join(bad),
        )
    )
    pride = backgrounds.get("pride")
    zhaohua = backgrounds.get("zhaohua")
    flashes = []
    for book, png in shot_paths.items():
        if not png.exists():
            flashes.append(f"{book} shot missing")
            continue
        width, _height, pixels = decode_png_rows(png)
        boxes = other_rects(width, pixels)
        if boxes:
            flashes.append(f"{book} {boxes[0]['w']}x{boxes[0]['h']}")
    kept = pride == (255, 255, 255) and zhaohua == (255, 255, 255) and not flashes
    detail = f"pride {pride}, zhaohua {zhaohua}"
    detail += "; " + ("; ".join(flashes) if flashes else "no other color")
    rows.append(
        check(
            "book-body-background",
            "reading-view",
            "window",
            "pass" if kept else "fail",
            detail,
        )
    )
    bands = []
    for book, png in shot_paths.items():
        if not png.exists():
            bands.append(f"{book} shot missing")
            continue
        width, _height, pixels = decode_png_rows(png)
        ok, band_detail = band_white(width, pixels)
        if not ok:
            bands.append(f"{book} {band_detail}")
        missing = missing_source_text(plains.get(book) or "", book)
        if missing:
            bands.append(f"{book} chapter {', '.join(missing)}")
    rows.append(
        check(
            "page-bands-white",
            "reading-view",
            "window",
            "pass" if not bands else "fail",
            "header, footer, margins, text #ffffff"
            if not bands
            else "; ".join(bands),
        )
    )
    return rows


def remember(qualities, name, body):
    tofu = body.get("tofu")
    gap = body.get("cjk_gap")
    qualities.append(
        {
            "name": name,
            "tofu": tofu if isinstance(tofu, int) else None,
            "cjk_gap": gap if isinstance(gap, int) else None,
        }
    )


def own_publisher():
    text = (ROOT / "spikes" / "justify" / "justify.js").read_text()
    match = re.search(r"const OWN_PUBLISHER = (true|false)", text)
    return bool(match and match.group(1) == "true")


def layout_of(item):
    layout = item.get("layout") if isinstance(item, dict) else None
    return layout if isinstance(layout, dict) else None


def layout_settled(item, generation=None):
    layout = layout_of(item)
    if not layout or not layout.get("ready") or layout.get("tail") != "done":
        return False
    if generation is not None and layout.get("generation") == generation:
        return False
    width = item.get("page_w") or 0
    settled = layout.get("settled_width")
    return isinstance(settled, (int, float)) and abs(float(settled) - float(width)) < 2


def gap_bar(layout):
    just = layout.get("justified_lines") or 0
    p95 = layout.get("gap_p95")
    ratio = layout.get("gap_ratio")
    loose = layout.get("loose_lines") or 0
    hy = layout.get("hyphen_lines") or 0
    detail = (
        f"p95 {p95} max {ratio} loose {loose}/{just} hy {hy}/{just} "
        f"run {layout.get('hyphen_run')} rivers {layout.get('rivers')} "
        f"overflow {layout.get('overflow_lines')} flush {layout.get('flush_err')} "
        f"box {layout.get('box_err')} "
        f"owned {layout.get('owned')} fall {layout.get('fallen_back')}"
    )
    if just <= 0:
        return False, "no justified lines " + detail
    problems = []
    flush = layout.get("flush_err")
    if isinstance(flush, (int, float)) and flush > 0.5:
        problems.append("flush")
    box = layout.get("box_err")
    if isinstance(box, (int, float)) and box > 0.5:
        problems.append("box")
    if layout.get("overflow_lines") not in (0, 0.0):
        problems.append("overflow")
    if not isinstance(p95, (int, float)) or p95 > 1.5:
        problems.append("p95")
    if not isinstance(ratio, (int, float)) or ratio > 2:
        problems.append("max")
    if loose / just > 0.03:
        problems.append("loose")
    if (layout.get("rivers") or 0) > 1:
        problems.append("rivers")
    if hy / just > 0.15:
        problems.append("hyphen")
    if (layout.get("hyphen_run") or 0) > 2:
        problems.append("hyphen run")
    if problems:
        return False, ", ".join(problems) + " " + detail
    return True, detail


def cjk_native(layout):
    pair = layout.get("dash_starts") == 0 and layout.get("orphan_dash_ends") == 0
    return layout.get("owned") == 0 and layout.get("forbidden_starts") == 0 and pair


def footer_ok(lines, png):
    footer = any("/" in line and "页" in line for line in lines)
    remainder = any("本章还剩" in line for line in lines)
    if png.exists() and not (footer and remainder):
        _w, height, pixel_rows = decode_png_rows(png)
        ink = 0
        for row in pixel_rows[max(0, height - 48) :]:
            for offset in range(0, len(row), 16):
                if row[offset] < 96 and row[offset + 1] < 96 and row[offset + 2] < 96:
                    ink += 1
        if ink >= 12:
            footer = True
            remainder = True
    return footer and remainder


def pride_trims(out, window_tool, ocr_tool, proto, qualities, notes):
    rows = []
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "trim-pride",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}),
        lambda names: False,
        25,
        lambda started: chapter_ready(started, "pride"),
    )
    design = ROOT / "docs" / "design" / "justification"
    design.mkdir(parents=True, exist_ok=True)
    try:
        anchor = ""
        seen_generation = None
        for name in ("32kai", "paperback", "trade"):
            if name != "32kai":
                write_trim(name)
            want_w, want_h = TRIMS[name]
            body = wait_json(
                state["started"],
                lambda item, want_w=want_w, want_h=want_h, name=name, seen=seen_generation: (
                    item.get("trim") == name
                    and item.get("page_source") == "trim"
                    and ratio_within(item.get("page_w") or 0, item.get("page_h") or 0, want_w, want_h)
                    and "truth universally acknowledged" in anchor_phrase(item)
                    and "Mr. Bennet" in flat_text(item.get("plain") or "")
                    and "Mrs. Long" in flat_text(item.get("plain") or "")
                    and layout_settled(item, seen)
                ),
                16,
            )
            phrase = anchor_phrase(body)
            if name == "32kai":
                anchor = phrase
            png = out / f"trim-{name}-pride.png"
            lines = page_shot(state, window_tool, ocr_tool, png)
            if png.exists():
                shutil.copyfile(png, proto / png.name)
                (out / f"trim-{name}-pride-ocr.txt").write_text("\n".join(lines) + "\n")
            body_ok = any(
                token in line.lower()
                for line in lines
                for token in ("acknowledged", "wife", "bennet", "truth", "neighbourhood")
            )
            ratio_ok = ratio_within(body.get("page_w") or 0, body.get("page_h") or 0, want_w, want_h)
            same = phrase == anchor and "truth universally acknowledged" in phrase
            ink = content_ink(png) if png.exists() else 0
            ok = png.exists() and footer_ok(lines, png) and body_ok and ratio_ok and same and ink > 400 and body.get("page_source") == "trim"
            gap = body.get("gap_ratio")
            rows.append(
                check(
                    f"trim-{name}-pride",
                    "reading-view",
                    "window",
                    "pass" if ok else "fail",
                    f"ratio {body.get('page_w')}/{body.get('page_h')} source {body.get('page_source')} anchor {phrase!r} gap {gap} lines {lines[:6]}",
                    png.name if png.exists() else None,
                )
            )
            layout = layout_of(body) or {}
            if layout.get("generation") is not None:
                seen_generation = layout.get("generation")
            passed, detail = gap_bar(layout) if layout else (False, "no layout")
            rows.append(
                check(
                    f"justify-pride-{name}",
                    "reading-view",
                    "window",
                    "pass" if passed else "fail",
                    detail,
                    png.name if png.exists() else None,
                )
            )
            if name in ("paperback", "32kai") and png.exists():
                shutil.copyfile(png, design / f"pride-{name}-fitted.png")
            if name == "32kai":
                fresh = webkit_body(state["started"]) or body
                remember(qualities, "pride", fresh)
                notes.append({"book": "pride", "body": fresh, "png": png})
    finally:
        finish_launch(state)
    return rows


def zhaohua_trims(out, window_tool, ocr_tool, proto, qualities, notes):
    rows = []
    write_trim("32kai")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "trim-zhaohua",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_BOOK": "zhaohua", "SPIKE_AT": "3"}),
        lambda names: False,
        30,
        lambda started: chapter_ready(started, "zhaohua"),
    )
    first_tokens = []
    seen_generation = None
    try:
        for name in ("32kai", "paperback", "trade"):
            if name != "32kai":
                write_trim(name)
            want_w, want_h = TRIMS[name]
            body = wait_json(
                state["started"],
                lambda item, want_w=want_w, want_h=want_h, name=name, seen=seen_generation: (
                    item.get("trim") == name
                    and item.get("page_source") == "trim"
                    and ratio_within(item.get("page_w") or 0, item.get("page_h") or 0, want_w, want_h)
                    and isinstance(item.get("pages"), list)
                    and (name == "32kai" or isinstance(item.get("pinned"), int))
                    and layout_settled(item, seen)
                ),
                16,
            )
            png = out / f"trim-{name}-zhaohua.png"
            lines = page_shot(state, window_tool, ocr_tool, png)
            if png.exists():
                shutil.copyfile(png, proto / png.name)
            tokens = []
            for line in lines:
                buf = ""
                for ch in line:
                    if "\u3400" <= ch <= "\u9fff":
                        buf += ch
                    else:
                        if len(buf) >= 2:
                            tokens.append(buf)
                        buf = ""
                if len(buf) >= 2:
                    tokens.append(buf)
            if name == "32kai":
                first_tokens = tokens
                marker = ""
                buf = ""
                for ch in "".join(lines):
                    if "\u3400" <= ch <= "\u9fff":
                        buf += ch
                    else:
                        if len(buf) > len(marker):
                            marker = buf
                        buf = ""
                if len(buf) > len(marker):
                    marker = buf
                first_tokens = [marker[:10]] if len(marker) >= 6 else tokens[:1]
            shared = any(token and token in "".join(lines) for token in first_tokens) if name != "32kai" else bool(tokens)
            prose = shared and not any("Project Gutenberg" in line for line in lines)
            ratio_ok = ratio_within(body.get("page_w") or 0, body.get("page_h") or 0, want_w, want_h)
            on_page = name != "32kai" or (isinstance(body.get("pages"), list) and body["pages"][0] >= 3)
            ink = content_ink(png) if png.exists() else 0
            ok = png.exists() and footer_ok(lines, png) and prose and ratio_ok and on_page and ink > 400 and body.get("page_source") == "trim"
            rows.append(
                check(
                    f"trim-{name}-zhaohua",
                    "reading-view",
                    "window",
                    "pass" if ok else "fail",
                    f"ratio {body.get('page_w')}/{body.get('page_h')} page {body.get('pages')} lines {lines[:6]}",
                    png.name if png.exists() else None,
                )
            )
            layout = layout_of(body) or {}
            if layout.get("generation") is not None:
                seen_generation = layout.get("generation")
            native = cjk_native(layout)
            rows.append(
                check(
                    f"justify-zhaohua-{name}",
                    "reading-view",
                    "window",
                    "pass" if native else "fail",
                    f"owned {layout.get('owned')} forbidden {layout.get('forbidden_starts')} "
                    f"dash_starts {layout.get('dash_starts')} orphan_ends {layout.get('orphan_dash_ends')}",
                    png.name if png.exists() else None,
                )
            )
            if name == "32kai":
                fresh = webkit_body(state["started"]) or body
                remember(qualities, "zhaohua", fresh)
                notes.append({"book": "zhaohua", "body": fresh, "png": png})
    finally:
        finish_launch(state)
    return rows


def style_books(out, window_tool, ocr_tool, proto, notes):
    rows = []
    specs = [
        ("styled", "reading-styled", lambda sample: (
            "Literata" in str(sample.get("font"))
            and sample.get("fontStatus") == "loaded"
            and near(px(sample.get("size")), 19)
            and near(px(sample.get("leading")), 19 * 1.65)
            and near(px(sample.get("indent")), 19 * 1.5)
            and sample.get("align") == "left"
        )),
        ("plain-en", "reading-plain-en", lambda sample: (
            "Iowan" in str(sample.get("font"))
            and near(px(sample.get("size")), 22)
            and near(px(sample.get("leading")), 22 * 1.48)
            and near(px(sample.get("indent")), 44)
            and sample.get("align") == "justify"
        )),
        ("plain-zh", "reading-plain-zh", lambda sample: (
            "Songti" in str(sample.get("font"))
            and near(px(sample.get("size")), 20)
            and near(px(sample.get("leading")), 34)
            and near(px(sample.get("indent")), 40)
            and sample.get("align") == "justify"
        )),
    ]
    write_trim("32kai")
    for book, check_id, pred in specs:
        WEBKIT_JSON.unlink(missing_ok=True)
        state = launch(
            out,
            check_id,
            child_env({"SPIKE_MODE": "webkit", "SPIKE_BOOK": book}),
            lambda names: False,
            25,
            lambda started: (
                (body := webkit_body(started)) is not None
                and isinstance(body.get("pages"), list)
                and body["pages"][1] > 1
                and isinstance(body.get("sample"), dict)
            ),
        )
        png = out / f"{check_id}.png"
        try:
            body = wait_json(
                state["started"],
                lambda item, pred=pred: (
                    isinstance(item.get("sample"), dict)
                    and pred(item["sample"])
                    and len(item.get("plain") or "") > 80
                    and layout_settled(item)
                ),
                16,
            )
            if state["alive"]:
                page_shot(state, window_tool, ocr_tool, png)
                if png.exists():
                    shutil.copyfile(png, proto / f"{book}.png")
                    fresh = webkit_body(state["started"]) or body
                    notes.append({"book": book, "body": fresh, "png": png})
        finally:
            finish_launch(state)
        sample = body.get("sample") if isinstance(body, dict) else {}
        ok = isinstance(sample, dict) and pred(sample)
        rows.append(
            check(
                check_id,
                "reading-view",
                "window",
                "pass" if ok else "fail",
                f"sample {sample}",
                png.name if png.exists() else None,
            )
        )
        if book == "styled":
            layout = layout_of(body) or {}
            rows.append(
                check(
                    "justify-styled",
                    "reading-view",
                    "window",
                    "pass" if layout.get("owned") == 0 else "fail",
                    f"owned {layout.get('owned')}",
                    png.name if png.exists() else None,
                )
            )
    return rows


def cycle_trims(out, name, env, ready, score):
    rows = []
    write_trim("paperback")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(out, name, child_env(env), lambda names: False, 30, ready)
    seen = None
    try:
        for trim in ("paperback", "32kai", "trade"):
            if trim != "paperback":
                write_trim(trim)
            want_w, want_h = TRIMS[trim]
            body = wait_json(
                state["started"],
                lambda item, want_w=want_w, want_h=want_h, trim=trim, seen=seen: (
                    item.get("trim") == trim
                    and item.get("page_source") == "trim"
                    and ratio_within(item.get("page_w") or 0, item.get("page_h") or 0, want_w, want_h)
                    and layout_settled(item, seen)
                ),
                16,
            )
            layout = layout_of(body) or {}
            if layout.get("generation") is not None:
                seen = layout.get("generation")
            rows.append(score(trim, body, layout))
    finally:
        finish_launch(state)
    return rows


def plain_en_bars(out):
    def score(trim, body, layout):
        passed, detail = gap_bar(layout) if layout else (False, "no layout")
        return check(f"justify-plain-en-{trim}", "reading-view", "window", "pass" if passed else "fail", detail)

    return cycle_trims(
        out,
        "justify-plain-en",
        {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "plain-en"},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("pages"), list)
            and body["pages"][1] > 1
        ),
        score,
    )


def plain_zh_bars(out):
    def score(trim, body, layout):
        native = cjk_native(layout)
        return check(
            f"justify-plain-zh-{trim}",
            "reading-view",
            "window",
            "pass" if native else "fail",
            f"owned {layout.get('owned')} forbidden {layout.get('forbidden_starts')} "
            f"dash_starts {layout.get('dash_starts')} orphan_ends {layout.get('orphan_dash_ends')}",
        )

    return cycle_trims(
        out,
        "justify-plain-zh",
        {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "plain-zh"},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("pages"), list)
            and body["pages"][1] > 1
        ),
        score,
    )


def publisher_bars(out):
    owning = own_publisher()

    def score(trim, body, layout):
        sample = body.get("sample") if isinstance(body, dict) else {}
        style = (
            isinstance(sample, dict)
            and "Literata" in str(sample.get("font"))
            and sample.get("align") == "justify"
            and near(px(sample.get("size")), 19)
        )
        if owning:
            passed, detail = gap_bar(layout) if layout else (False, "no layout")
            passed = passed and style
        else:
            passed = style and layout.get("owned") == 0
            detail = f"owned {layout.get('owned')} align {sample.get('align') if isinstance(sample, dict) else None}"
        return check(
            f"justify-publisher-{trim}",
            "reading-view",
            "window",
            "pass" if passed else "fail",
            detail,
        )

    return cycle_trims(
        out,
        "justify-publisher",
        {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "publisher"},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("sample"), dict)
        ),
        score,
    )


def native_pride_shots(out, window_tool, ocr_tool):
    design = ROOT / "docs" / "design" / "justification"
    design.mkdir(parents=True, exist_ok=True)
    write_trim("paperback")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "justify-native",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1", "SPIKE_JUSTIFY": "0"}),
        lambda names: False,
        30,
        lambda started: chapter_ready(started, "pride"),
    )
    census = {}
    seen = None
    try:
        for name in ("paperback", "32kai"):
            if name != "paperback":
                write_trim(name)
            want_w, want_h = TRIMS[name]
            body = wait_json(
                state["started"],
                lambda item, want_w=want_w, want_h=want_h, name=name, seen=seen: (
                    item.get("trim") == name
                    and layout_settled(item, seen)
                    and ratio_within(item.get("page_w") or 0, item.get("page_h") or 0, want_w, want_h)
                ),
                16,
            )
            layout = layout_of(body) or {}
            if layout.get("generation") is not None:
                seen = layout.get("generation")
            census[name] = layout
            png = out / f"pride-{name}-native.png"
            if state["alive"]:
                page_shot(state, window_tool, ocr_tool, png)
                if png.exists():
                    shutil.copyfile(png, design / png.name)
    finally:
        finish_launch(state)
    (design / "before.json").write_text(json.dumps(census, indent=2) + "\n")
    return census


def breaks_dir():
    return SETTINGS.parent / "breaks"


def clear_breaks():
    path = breaks_dir()
    if path.exists():
        shutil.rmtree(path)


def private_support(out):
    global SETTINGS
    support = Path(tempfile.mkdtemp(prefix=f"superreader-verify-{out.name}-"))
    os.environ["SUPERREADER_SUPPORT_DIR"] = str(support)
    SETTINGS = support / "settings.json"
    print(f"support {support}", flush=True)


def timed_open(out, name, justify, extra, watch, timeout=45):
    WEBKIT_JSON.unlink(missing_ok=True)
    env = {"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}
    env.update(extra)
    if not justify:
        env["SPIKE_JUSTIFY"] = "0"
    state = launch(out, name, child_env(env), lambda names: False, timeout, watch)
    try:
        body = webkit_body(state["started"]) or {}
    finally:
        finish_launch(state)
    return body if isinstance(body, dict) else {}


def cache_subset(out):
    write_trim("paperback")
    global RUN_TOP
    RUN_TOP = top_cpu()
    return [warm_cached(out), hyphen_reopen(out), chapter_turn(out), trim_stamp(out), resize_breaks(out)]


def page_ready_runs(out):
    write_trim("paperback")
    global RUN_TOP
    RUN_TOP = top_cpu()
    rows = []
    rows.append(cold_open(out))
    rows.append(warm_open(out))
    rows.append(warm_cached(out))
    rows.append(hyphen_reopen(out))
    rows.append(trim_stamp(out))
    rows.append(resize_breaks(out))
    rows.append(chapter_turn(out))
    return rows


def top_cpu(limit=8):
    proc = subprocess.run(["ps", "-axo", "pcpu=,comm="], capture_output=True, text=True)
    rows = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        cpu, _, comm = line.partition(" ")
        try:
            value = float(cpu)
        except ValueError:
            continue
        rows.append((value, comm.strip()))
    rows.sort(reverse=True)
    return [{"cpu": cpu, "command": comm} for cpu, comm in rows[:limit]]


def reap_our_shells():
    root = str(ROOT / "spikes" / "target")
    proc = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True)
    for line in proc.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2 or "spike-shell" not in parts[1]:
            continue
        if root not in parts[1]:
            continue
        try:
            os.kill(int(parts[0]), 15)
        except OSError:
            pass


def warm_cached(out):
    reap_our_shells()
    clear_breaks()
    timed_open(
        out,
        "cached-prime",
        True,
        {},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
        ),
    )
    body = timed_open(
        out,
        "cached-reopen",
        True,
        {},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
        ),
    )
    layout = body.get("layout") if isinstance(body.get("layout"), dict) else {}
    source = layout.get("break_source")
    live = layout.get("live_calls")
    global WARM_PHASES
    ready = body.get("page_ready_ms")
    opened = body.get("open_ms")
    since = body.get("ready_since_process_ms")
    WARM_PHASES = {
        "load": loadavg(),
        "top": top_cpu(),
        "break_source": source,
        "live_calls": live,
        "ready_since_process_ms": since,
        "open_ms": opened,
        "page_ready_ms": ready,
        "apply_ms": layout.get("apply_ms"),
        "before_clock_ms": None
        if not isinstance(since, (int, float)) or not isinstance(ready, (int, float))
        else since - ready,
        "after_navigation_ms": None
        if not isinstance(ready, (int, float)) or not isinstance(opened, (int, float))
        else ready - opened,
        "misses": layout.get("misses") or [],
    }
    ok = source == "cached" and live == 0
    return check(
        "reading-warm-cached",
        "reading-view",
        "window",
        "pass" if ok else "fail",
        f"break_source {source} live_calls {live} apply_ms {layout.get('apply_ms')} "
        f"open_ms {opened} page_ready_ms {ready} load {loadavg()}",
    )


def score_times(check_id, times, native_times, errors, extra=""):
    if len(times) != 5:
        return check(
            check_id,
            "reading-view",
            "window",
            "fail",
            f"errors {errors}, samples {times}, native {native_times}, load {loadavg()} {extra}".strip(),
        )
    ordered = sorted(times)
    detail = (
        f"p95 {ordered[-1]:.1f} ms, min {ordered[0]:.1f}, median {ordered[2]:.1f}, "
        f"max {ordered[-1]:.1f}, load {loadavg()}, errors {errors}, "
        f"native {', '.join(f'{item:.0f}' for item in native_times)} {extra}"
    ).strip()
    if errors == 0 and ordered[-1] > 300 and native_times and max(native_times) > 300:
        detail += " Baseline failure shared with native, not a regression."
    return check(
        check_id,
        "reading-view",
        "window",
        "pass" if errors == 0 and ordered[-1] <= 300 else "fail",
        detail,
    )


def cold_open(out):
    times = []
    native_times = []
    errors = 0
    for index in range(5):
        for justify, bucket in ((True, times), (False, native_times)):
            if justify:
                clear_breaks()
            body = timed_open(
                out,
                f"cold-{index}-{'on' if justify else 'off'}",
                justify,
                {},
                lambda started: (
                    (body := webkit_body(started)) is not None
                    and isinstance(body.get("page_ready_ms"), (int, float))
                    and layout_settled(body)
                ),
            )
            value = body.get("page_ready_ms")
            if isinstance(value, (int, float)):
                bucket.append(float(value))
            else:
                errors += 1
    return score_times("reading-cold-open", times, native_times, errors, "cache cleared before each fitted open")


def warm_open(out):
    clear_breaks()
    timed_open(
        out,
        "warm-prime",
        True,
        {},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
        ),
    )
    times = []
    native_times = []
    errors = 0
    sources = []
    for index in range(5):
        for justify, bucket in ((True, times), (False, native_times)):
            body = timed_open(
                out,
                f"warm-{index}-{'on' if justify else 'off'}",
                justify,
                {},
                lambda started: (
                    (body := webkit_body(started)) is not None
                    and isinstance(body.get("page_ready_ms"), (int, float))
                    and layout_settled(body)
                ),
            )
            value = body.get("page_ready_ms")
            if isinstance(value, (int, float)):
                bucket.append(float(value))
                if justify:
                    sources.append(body.get("break_source"))
            else:
                errors += 1
    cached = sources.count("cached")
    extra = f"break_source {sources}"
    return score_times("reading-warm-open", times, native_times, errors, extra)


def chapter_turn(out):
    times = []
    native_times = []
    errors = 0
    hrefs = []
    for index in range(5):
        for justify, bucket in ((True, times), (False, native_times)):
            body = timed_open(
                out,
                f"chapter-{index}-{'on' if justify else 'off'}",
                justify,
                {"SPIKE_NEXT": "1"},
                lambda started: (
                    (body := webkit_body(started)) is not None
                    and isinstance(body.get("chapter_ms"), (int, float))
                    and "chapter-1" not in str(body.get("href") or "")
                ),
                60,
            )
            value = body.get("chapter_ms")
            href = str(body.get("href") or "")
            if isinstance(value, (int, float)) and "chapter-1" not in href:
                bucket.append(float(value))
                if justify:
                    hrefs.append(href)
            else:
                errors += 1
    return score_times("reading-chapter-turn", times, native_times, errors, f"hrefs {hrefs}")


def wait_while(state, timeout, pred):
    deadline = time.time() + timeout
    body = {}
    while time.time() < deadline:
        if state["proc"].poll() is not None:
            break
        body = webkit_body(state["started"]) or {}
        if pred(body):
            return body
        time.sleep(0.3)
    return webkit_body(state["started"]) or body


def cut_kinds(body):
    layout = layout_of(body)
    kinds = layout.get("cut_kinds")
    return kinds if isinstance(kinds, str) else ""


def hyphen_marks(body):
    marks = layout_of(body).get("hyphen_marks")
    return marks if isinstance(marks, int) else -1


def hyphen_reopen(out):
    reap_our_shells()
    clear_breaks()
    write_trim("paperback")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "hyphen-prime",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}),
        lambda names: False,
        45,
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
            and "h" in cut_kinds(body)
            and hyphen_marks(body) > 0
        ),
    )
    try:
        first = webkit_body(state["started"]) or {}
        time.sleep(0.8)
    finally:
        finish_launch(state)
    first_kinds = cut_kinds(first)
    first_marks = hyphen_marks(first)
    reopen = timed_open(
        out,
        "hyphen-reopen",
        True,
        {},
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
            and layout_of(body).get("live_calls") == 0
        ),
    )
    layout = layout_of(reopen)
    kinds = cut_kinds(reopen)
    marks = hyphen_marks(reopen)
    ok = (
        "h" in first_kinds
        and first_marks > 0
        and kinds == first_kinds
        and marks == first_marks
        and layout.get("live_calls") == 0
        and layout.get("break_source") == "cached"
    )
    return check(
        "reading-hyphen-reopen",
        "reading-view",
        "window",
        "pass" if ok else "fail",
        f"cuts {first_kinds.count('h')}h/{len(first_kinds)} reopen {kinds.count('h')}h/{len(kinds)} "
        f"marks {first_marks} to {marks} live_calls {layout.get('live_calls')} "
        f"break_source {layout.get('break_source')} load {loadavg()}",
    )


def trim_stamp(out):
    reap_our_shells()
    clear_breaks()
    write_trim("paperback")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "trim-stamp",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}),
        lambda names: False,
        45,
        lambda started: (
            (body := webkit_body(started)) is not None
            and body.get("trim") == "paperback"
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
        ),
    )
    changed = {}
    paperback_w = 0.0
    try:
        first = webkit_body(state["started"]) or {}
        paperback_w = float(first.get("page_w") or 0)
        write_trim("32kai")
        changed = wait_while(
            state,
            40,
            lambda body: (
                body.get("trim") == "32kai"
                and layout_settled(body)
                and abs(float(body.get("page_w") or 0) - paperback_w) > 20
            ),
        )
        time.sleep(0.8)
    finally:
        finish_launch(state)
    new_w = float(changed.get("page_w") or 0)
    reopen = timed_open(
        out,
        "trim-stamp-reopen",
        True,
        {},
        lambda started: (
            (body := webkit_body(started)) is not None
            and body.get("trim") == "32kai"
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
        ),
    )
    layout = layout_of(reopen)
    source = layout.get("break_source")
    live = layout.get("live_calls")
    reopen_w = float(reopen.get("page_w") or 0)
    ok = (
        source == "cached"
        and live == 0
        and new_w > 1
        and abs(reopen_w - new_w) < 2
        and abs(reopen_w - paperback_w) > 20
    )
    return check(
        "reading-trim-stamp",
        "reading-view",
        "window",
        "pass" if ok else "fail",
        f"paperback {paperback_w:.1f} 32kai {new_w:.1f} reopen {reopen_w:.1f} "
        f"break_source {source} live_calls {live} load {loadavg()}",
    )


def shrink_shell():
    script = '''
tell application "System Events"
  tell process "spike-shell"
    set size of window 1 to {460, 700}
  end tell
end tell
'''
    proc = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if proc.returncode != 0:
        return (proc.stderr or proc.stdout or "resize failed").strip()
    return ""


def resize_breaks(out):
    reap_our_shells()
    write_trim("paperback")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "resize-breaks",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}),
        lambda names: False,
        45,
        lambda started: (
            (body := webkit_body(started)) is not None
            and isinstance(body.get("page_ready_ms"), (int, float))
            and layout_settled(body)
        ),
    )
    try:
        first = webkit_body(state["started"]) or {}
        before = float(first.get("page_w") or 0)
        err = shrink_shell()
        after = wait_while(
            state,
            25,
            lambda body: (
                layout_settled(body)
                and float(body.get("page_w") or 0) < before - 30
                and (layout_of(body).get("owned") or 0) > 0
            ),
        )
    finally:
        finish_launch(state)
    layout = layout_of(after)
    width = float(after.get("page_w") or 0)
    ok = err == "" and layout.get("ready") is True and width < before - 30 and (layout.get("owned") or 0) > 0
    detail = (
        f"before {before:.1f} after {width:.1f} owned {layout.get('owned')} "
        f"ready {layout.get('ready')} load {loadavg()}"
    )
    if err:
        detail = f"{err}. {detail}"
    return check(
        "reading-resize-breaks",
        "reading-view",
        "window",
        "pass" if ok else "fail",
        detail,
    )


def layout_and_text_checks(notes):
    off = []
    rules = []
    dropped = []
    for note in notes:
        body = note["body"] if isinstance(note.get("body"), dict) else {}
        book = note["book"]
        if not page_centered(body):
            off.append(
                f"{book} x {body.get('page_x')} w {body.get('page_w')} stage {body.get('stage_w')}"
            )
        png = note.get("png")
        if png and Path(png).exists():
            rule = vertical_rule(png)
            if rule is not None:
                rules.append(f"{book} x {rule}")
        plain = body.get("plain") or ""
        missing = missing_source_text(plain, book)
        copies = duplicate_blocks(plain)
        if missing or copies:
            dropped.append(f"{book} missing {missing} copies {copies[:4]}")
    rows = [
        check(
            "reading-page-box",
            "reading-view",
            "window",
            "pass" if notes and not off and not rules else "fail",
            "centered" if not off and not rules else f"offset {off} rule {rules}",
        )
    ]
    rows.append(
        check(
            "reading-text-complete",
            "reading-view",
            "window",
            "pass" if notes and not dropped else "fail",
            "source text is on the page" if not dropped else f"dropped {dropped}",
        )
    )
    return rows


def fixed_book(out):
    write_trim("paperback")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "reading-fixed",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_BOOK": "fixed"}),
        lambda names: False,
        25,
        lambda started: (
            (body := webkit_body(started)) is not None
            and body.get("page_source") == "declared"
            and ratio_within(body.get("page_w") or 0, body.get("page_h") or 0, 1000, 1000)
        ),
    )
    try:
        first = wait_json(
            state["started"],
            lambda item: item.get("page_source") == "declared" and ratio_within(item.get("page_w") or 0, item.get("page_h") or 0, 1000, 1000),
            6,
        )
        write_trim("trade")
        time.sleep(1.2)
        second = wait_json(state["started"], lambda item: item.get("trim") == "trade", 6)
    finally:
        finish_launch(state)
    ok = (
        first.get("page_source") == "declared"
        and second.get("page_source") == "declared"
        and second.get("trim") == "trade"
        and ratio_within(first.get("page_w") or 0, first.get("page_h") or 0, 1, 1)
        and ratio_within(second.get("page_w") or 0, second.get("page_h") or 0, 1, 1)
    )
    return [
        check(
            "reading-fixed-ignores-trim",
            "reading-view",
            "window",
            "pass" if ok else "fail",
            f"first {first.get('page_w')}/{first.get('page_h')} {first.get('page_source')} second {second.get('page_w')}/{second.get('page_h')} trim {second.get('trim')}",
        )
    ]


def slide_ready():
    seen = {"size": None, "since": 0.0}

    def ready(started):
        if not chapter_ready(started, "pride"):
            return False
        body = webkit_body(started)
        if not isinstance(body, dict) or not layout_settled(body):
            return False
        size = (round(float(body.get("page_w") or 0), 1), round(float(body.get("page_h") or 0), 1))
        now = time.time()
        if size != seen["size"]:
            seen["size"] = size
            seen["since"] = now
            return False
        return now - seen["since"] >= 0.7

    return ready


def slide_turn(out, window_tool, proto):
    write_trim("32kai")
    WEBKIT_JSON.unlink(missing_ok=True)
    state = launch(
        out,
        "reading-slide",
        child_env({"SPIKE_MODE": "webkit", "SPIKE_PLAY": "1"}),
        lambda names: False,
        25,
        slide_ready(),
    )
    video = out / "reading-slide.mp4"
    frames = []
    try:
        if state["alive"]:
            wid = window_id(window_tool, state["pid"])
            if wid:
                capture_video(wid, video, 5)
        body = webkit_body(state["started"]) or {}
        raw = body.get("frame_ms") or []
        frames = [float(item) for item in raw if isinstance(item, (int, float))]
    finally:
        finish_launch(state)
    if video.exists():
        shutil.copyfile(video, proto / "slide.mp4")
    floor = bool(frames) and all(item < 33.4 for item in frames) and video.exists()
    report = {"floor_ms": 16.7, "loadavg": loadavg(), "frames_ms": frames, "ok": floor}
    (proto / "latency.json").write_text(json.dumps(report, indent=2) + "\n")
    (out / "reading-latency.json").write_text(json.dumps(report, indent=2) + "\n")
    return [
        check(
            "reading-slide",
            "reading-view",
            "window",
            "pass" if floor else "fail",
            f"frames {frames} floor 16.7 ms video {video.exists()}",
            video.name if video.exists() else None,
        )
    ]



def run_measure(out):
    samples = []
    errors = []
    for index in range(1, MEASURE_RUNS + 1):
        proc = subprocess.run(
            [str(release_bin("spike-measure")), "pdf", "pdfium", "retina-1x"],
            cwd=SPIKES,
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            errors.append(proc.stderr.strip() or f"run {index} exited {proc.returncode}")
            continue
        try:
            samples.append(json.loads(proc.stdout))
        except json.JSONDecodeError as exc:
            errors.append(f"run {index} {exc}")
    (out / "measure.json").write_text(json.dumps(samples, indent=2) + "\n")
    if len(samples) != MEASURE_RUNS:
        detail = "; ".join(errors) or "measure produced no samples"
        return [
            check("pdf-open-to-first", "reading-bars", "measure", "fail", detail, "measure.json"),
            check("pdf-later-page", "reading-bars", "measure", "fail", detail, "measure.json"),
        ]
    opens = [sample["open_to_first_ms"] for sample in samples]
    later = [value for sample in samples for value in sample["later_page_ms"]]
    error_count = sum(sample["errors"] for sample in samples)
    hits = min(sample["text_hits"] for sample in samples)
    rgba = all(sample["rgba_ok"] for sample in samples)
    release = all(sample["release"] for sample in samples)
    healthy = error_count == 0 and hits >= 2 and rgba and release
    open_median = median(opens)
    later_median = median(later)
    health = (
        f"load {loadavg()}, {MEASURE_RUNS} release runs, errors {error_count}, "
        f"text hits min {hits}, rgba ok {rgba}. "
        "Each sample times Document::raster in spikes/pdf and checks the bitmap length."
    )
    open_ok = healthy and open_median < OPEN_TO_FIRST_MS
    later_ok = healthy and later_median <= LATER_PAGE_MS
    return [
        check(
            "pdf-open-to-first",
            "reading-bars",
            "measure",
            "pass" if open_ok else "fail",
            f"median {open_median:.1f} ms, range {min(opens):.1f} to {max(opens):.1f}, floor {OPEN_TO_FIRST_MS:.0f} ms. {health}",
            "measure.json",
        ),
        check(
            "pdf-later-page",
            "reading-bars",
            "measure",
            "pass" if later_ok else "fail",
            f"median {later_median:.1f} ms, range {min(later):.1f} to {max(later):.1f}, floor {LATER_PAGE_MS} ms. {health}",
            "measure.json",
        ),
    ]


def chrome_plan(ratio_w, ratio_h, visible_w, visible_h):
    ratio = ratio_w / ratio_h
    max_w = max(visible_w * CHROME_FIT, 1.0)
    max_h = max(visible_h * CHROME_FIT, 1.0)
    page_h = max(min(max_h - CHROME_TOP, (max_w - CHROME_SIDE * 2.0) / ratio), 1.0)
    page_w = page_h * ratio
    return page_w + CHROME_SIDE * 2.0, page_h + CHROME_TOP


def chrome_clear(body):
    page_y = float(body.get("page_y") or 0)
    page_h = float(body.get("page_h") or 0)
    return page_h > 100 and page_y + 0.5 >= CHROME_LIGHTS


def placed_page(stage_w, stage_h, ratio_w, ratio_h):
    ratio = ratio_w / ratio_h
    box_w = max(stage_w - CHROME_SIDE * 2.0, 1.0)
    box_h = max(stage_h - CHROME_TOP, 1.0)
    if box_w / box_h > ratio:
        height = box_h
        width = box_h * ratio
    else:
        width = box_w
        height = box_w / ratio
    return (stage_w - width) / 2.0, CHROME_TOP + (box_h - height) / 2.0, width, height


def chrome_body(started):
    return read_chrome(CHROME_JSON, started)


def chrome_pid_body(started, pid):
    body = read_chrome(CHROME_JSON.parent / f"chrome-{pid}.json", started)
    if not isinstance(body, dict) or int(body.get("pid") or -1) != int(pid):
        return None
    return body


def read_chrome(path, started):
    if not path.exists() or path.stat().st_mtime + 0.05 < started:
        return None
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return None


def compile_mouse(out):
    source = out / "mouse.swift"
    source.write_text(
        """
import CoreGraphics
guard CommandLine.arguments.count > 2,
      let x = Double(CommandLine.arguments[1]),
      let y = Double(CommandLine.arguments[2]) else {
  exit(2)
}
let point = CGPoint(x: x, y: y)
guard let event = CGEvent(mouseEventSource: nil, mouseType: .mouseMoved, mouseCursorPosition: point, mouseButton: .left) else {
  exit(1)
}
event.post(tap: .cghidEventTap)
"""
    )
    binary = out / "mouse"
    proc = subprocess.run(["swiftc", "-O", "-o", str(binary), str(source)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "mouse swiftc failed")
    return binary


def compile_keys(out):
    source = out / "keys.swift"
    source.write_text(
        """
import CoreGraphics
import Foundation
let name = CommandLine.arguments.count > 1 ? CommandLine.arguments[1] : ""
let key: CGKeyCode
var flags = CGEventFlags()
if name == "immersive" {
  key = 34
  flags = [.maskControl, .maskCommand]
} else if name == "escape" {
  key = 53
} else {
  fputs("unknown key\\n", stderr)
  exit(2)
}
func post(_ down: Bool) {
  guard let event = CGEvent(keyboardEventSource: nil, virtualKey: key, keyDown: down) else { exit(1) }
  event.flags = flags
  event.post(tap: .cghidEventTap)
}
post(true)
usleep(30_000)
post(false)
"""
    )
    binary = out / "keys"
    proc = subprocess.run(["swiftc", "-O", "-o", str(binary), str(source)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "keys swiftc failed")
    return binary


def post_key(keys, name):
    proc = subprocess.run([str(keys), name], capture_output=True, text=True)
    if proc.returncode != 0:
        return (proc.stderr or proc.stdout or "key failed").strip()
    return ""


def park_mouse(mouse, screen_h):
    y = max(80.0, screen_h - 40.0)
    subprocess.run([str(mouse), "40", str(y)], capture_output=True)


def chrome_ready(started, book, fullscreen=False, lights=None):
    if not chapter_ready(started, book):
        return False
    body = chrome_body(started)
    if not isinstance(body, dict) or float(body.get("page_h") or 0) < 100:
        return False
    if fullscreen and not body.get("fullscreen"):
        return False
    if lights == "hide" and float(body.get("lights") or 0) > 0.2:
        return False
    return True


def reveal_lights(mouse, metrics):
    if "x" not in metrics:
        return False
    x = metrics["x"] + 120.0
    y = metrics["y"] + 8.0
    subprocess.run([str(mouse), str(x), str(y)], capture_output=True)
    return True


def chrome_shot(out, window_tool, ocr_tool, mouse, name, env, book, fullscreen=False, lights=None):
    if lights == "hide":
        park_mouse(mouse, 1000)
    state = launch(
        out,
        name,
        child_env(env),
        lambda names: False,
        35,
        lambda started, book=book, fullscreen=fullscreen, lights=lights: chrome_ready(
            started, book, fullscreen, lights
        ),
    )
    png = out / f"{name}.png"
    try:
        if not state["alive"]:
            return state, None, [], f"{name} exited"
        if fullscreen:
            time.sleep(0.8)
        metrics = None
        last = "no window"
        for _ in range(6):
            metrics = window_metrics(window_tool, state["pid"])
            if metrics is None:
                time.sleep(0.3)
                continue
            if lights == "hide" or fullscreen:
                park_mouse(mouse, metrics["screen_h"])
                time.sleep(0.35)
            if lights == "show":
                reveal_lights(mouse, metrics)
                time.sleep(0.45)
            try:
                capture(metrics["id"], png)
                last = ""
                break
            except RuntimeError as exc:
                last = str(exc).strip()
                time.sleep(0.4)
        if last:
            return state, metrics, [], last
        lines = ocr_lines(ocr_tool, png)
        body = chrome_body(state["started"]) or {}
        return state, metrics, lines, body
    except Exception as exc:
        return state, None, [], str(exc)


def chrome_aspect_detail(metrics, ratio_w, ratio_h):
    plan_w, plan_h = chrome_plan(ratio_w, ratio_h, metrics["vis_w"], metrics["vis_h"])
    got_w = metrics["w"]
    got_h = metrics["h"]
    if abs(got_w - plan_w) > 8 and metrics["scale"] > 1 and abs(got_w / metrics["scale"] - plan_w) <= 8:
        got_w /= metrics["scale"]
        got_h /= metrics["scale"]
    want = plan_w / plan_h
    got = got_w / got_h if got_h else 0
    ratio_ok = want > 0 and abs(got - want) / want <= 0.02
    size_ok = abs(got_w - plan_w) <= 8 and abs(got_h - plan_h) <= 8
    detail = (
        f"window {got_w:.1f}x{got_h:.1f} plan {plan_w:.1f}x{plan_h:.1f} "
        f"on {metrics['vis_w']:.0f}x{metrics['vis_h']:.0f}"
    )
    return ratio_ok and size_ok, detail


def light_gaps(close_min_x, zoom_max_x, bar_x, bar_w):
    left = close_min_x - bar_x
    right = bar_x + bar_w - zoom_max_x
    return left, right


def bar_column_px(width, rows):
    if width < 10 or not rows:
        return 0
    channels = len(rows[0]) // width
    if channels < 3:
        return 0
    y0 = int(len(rows) * 0.25)
    y1 = max(int(len(rows) * 0.75), y0 + 1)
    step = max((y1 - y0) // 8, 1)
    samples = []
    for y in range(y0, y1, step):
        row = rows[y]
        run = 0
        x = 0
        while x < width:
            offset = x * channels
            if (
                abs(row[offset] - 228) > 10
                or abs(row[offset + 1] - 228) > 10
                or abs(row[offset + 2] - 230) > 10
            ):
                break
            run += 1
            x += 1
        if 2 < run < width - 2:
            samples.append(run)
    if not samples:
        return 0
    return int(median(samples))


def bar_column_pt(width, rows, window_w):
    pixels = bar_column_px(width, rows)
    if pixels <= 0 or window_w <= 0:
        return None
    return pixels * float(window_w) / width


def neutral_bar_px(width, rows):
    """Pixels of the left bar, including the dark window edge and a compressed gray.

    The painted column is #E4E4E6. A captured movie shifts that toward 223 and
    draws a dark corner on top of a slightly wider title band. The run stops
    at the first paper-white or chromatic pixel, so it does not cross the page.
    """
    if not rows or width < 10:
        return 0
    channels = len(rows[0]) // width
    if channels < 3:
        return 0
    runs = []
    step = max(len(rows) // 24, 1)
    for y in range(0, len(rows), step):
        row = rows[y]
        run = 0
        x = 0
        while x < width:
            offset = x * channels
            red, green, blue = row[offset], row[offset + 1], row[offset + 2]
            if max(red, green, blue) - min(red, green, blue) > 12 or min(red, green, blue) >= 242:
                break
            run += 1
            x += 1
        if 2 < run < width - 2:
            runs.append(run)
    if not runs:
        return 0
    return max(runs)


def past_bar(width, rows):
    skip = neutral_bar_px(width, rows)
    if skip <= 0 or not rows or width <= skip:
        return width, rows
    channels = len(rows[0]) // width
    if channels < 3:
        return width, rows
    return width - skip, [row[skip * channels :] for row in rows]


def clear_bar_hooks():
    for path in (SHELL_FRAME, BAR_IMMERSIVE, BAR_FULLSCREEN):
        path.unlink(missing_ok=True)


def top_is_paper(width, rows, rows_px=60, skip_px=0):
    paper = (255, 255, 255)
    if not rows or width < 1 or len(rows) < rows_px:
        return False, f"capture is {len(rows)} px tall"
    channels = len(rows[0]) // width
    if channels < 3:
        return False, "png row is shorter than the width"
    bad = 0
    total = 0
    for row in rows[:rows_px]:
        x = channels * max(skip_px, 4)
        limit = len(row) - channels * 4
        while x + 2 < limit:
            if (
                abs(row[x] - paper[0]) > 8
                or abs(row[x + 1] - paper[1]) > 8
                or abs(row[x + 2] - paper[2]) > 8
            ):
                bad += 1
            total += 1
            x += channels * 4
    if total == 0:
        return False, "no samples in the top band"
    return bad == 0, f"top {rows_px} px, {bad} of {total} samples off #ffffff"


def column_filled(body):
    gap = body.get("fill_gap")
    line = body.get("line_h")
    if not isinstance(gap, (int, float)) or not isinstance(line, (int, float)) or line <= 0:
        return False, "column fill was not reported"
    ok = 0 <= gap < line
    return ok, f"gap {gap:.1f} px under a {line:.1f} px line"


def gap_divider_count(png, chrome, web):
    if not Path(png).exists():
        return None, "shot missing"
    try:
        width, height, rows = decode_png_rows(png)
    except (OSError, ValueError) as exc:
        return None, str(exc)
    chrome = chrome if isinstance(chrome, dict) else {}
    web = web if isinstance(web, dict) else {}
    try:
        stage = float(chrome.get("stage_w") or web.get("stage_w") or 0)
        page_x = float(chrome["page_x"])
        page_y = float(chrome["page_y"])
        page_w = float(chrome.get("page_w") or web.get("page_w") or 0)
        last_bottom = float(web["last_bottom"])
        text_top = float(web["footer_text_top"])
    except (TypeError, ValueError, KeyError):
        return None, "gap band was not reported"
    if stage <= 0 or page_w <= 1 or width < 1 or height < 1:
        return None, "gap band was not reported"
    if text_top <= last_bottom:
        return None, f"footer text {text_top:.1f} is not below the last line {last_bottom:.1f}"
    scale = width / stage
    y0 = max(0, min(height, int(round((page_y + last_bottom) * scale))))
    y1 = max(0, min(height, int(round((page_y + text_top) * scale))))
    x0 = max(0, min(width, int(round(page_x * scale))))
    x1 = max(0, min(width, int(round((page_x + page_w) * scale))))
    if y1 <= y0 or x1 <= x0:
        return None, f"gap band is empty after scale {scale:.2f}"
    channels = len(rows[0]) // width
    if channels < 3:
        return None, "png row is shorter than the width"
    count = 0
    first = None
    for y in range(y0, y1):
        row = rows[y]
        for x in range(x0, x1):
            if glyph_near(rows, width, channels, x, y):
                continue
            offset = x * channels
            red, green, blue = row[offset], row[offset + 1], row[offset + 2]
            if near_white(red, green, blue):
                continue
            count += 1
            if first is None:
                first = (x, y, red, green, blue)
    if first:
        x, y, red, green, blue = first
        return count, f"{count} divider pixels, first {red},{green},{blue} at {x},{y}"
    return 0, f"0 divider pixels from {y0} to {y1}"


def footer_on_measure(body):
    values = [body.get(key) for key in ("footer_left", "measure_left", "footer_right", "measure_right")]
    if any(not isinstance(value, (int, float)) for value in values):
        return False, "footer and measure edges were not reported"
    left, measure_left, right, measure_right = values
    ok = abs(left - measure_left) <= 2 and abs(right - measure_right) <= 2 and right - left > 80
    return ok, f"footer {left:.1f} to {right:.1f}, measure {measure_left:.1f} to {measure_right:.1f}"


def glyph_near(rows, width, channels, x, y):
    height = len(rows)
    for dy in (-2, -1, 0, 1, 2):
        yy = y + dy
        if yy < 0 or yy >= height:
            continue
        row = rows[yy]
        for dx in (-2, -1, 0, 1, 2):
            xx = x + dx
            if xx < 0 or xx >= width:
                continue
            offset = xx * channels
            if offset + 2 >= len(row):
                continue
            if max(row[offset], row[offset + 1], row[offset + 2]) < 160:
                return True
    return False


def white_mask(width, rows):
    if not rows or width < 4:
        return 0, bytearray()
    channels = len(rows[0]) // width
    if channels < 3:
        return 0, bytearray()
    step = 4
    cols = width // step
    row_count = len(rows) // step
    if cols < 1 or row_count < 1:
        return 0, bytearray()
    grid = bytearray(cols * row_count)
    for gy in range(row_count):
        sample = rows[gy * step + step // 2]
        for gx in range(cols):
            offset = (gx * step + step // 2) * channels
            if offset + 2 >= len(sample):
                continue
            red, green, blue = sample[offset], sample[offset + 1], sample[offset + 2]
            if min(red, green, blue) >= 242:
                continue
            if max(red, green, blue) < 96:
                continue
            if red >= 200 and green >= 160 and blue <= 210 and red >= blue + 30 and green >= blue + 20:
                continue
            if field_gray(red, green, blue):
                continue
            # A glyph's gray edge is within two pixels of its ink, same as
            # page-bands-white. The white and ink cutoffs above stay put.
            sx = gx * step + step // 2
            sy = gy * step + step // 2
            if glyph_near(rows, width, channels, sx, sy):
                continue
            grid[gy * cols + gx] = 1
    return cols, grid


def rects_on_grid(cols, grid, minimum=20):
    if cols < 1 or not grid:
        return []
    row_count = len(grid) // cols
    step = 4
    seen = bytearray(cols * row_count)
    found = []
    for start in range(cols * row_count):
        if not grid[start] or seen[start]:
            continue
        stack = [start]
        seen[start] = 1
        count = 0
        minx = maxx = start % cols
        miny = maxy = start // cols
        while stack:
            cur = stack.pop()
            count += 1
            cx = cur % cols
            cy = cur // cols
            minx = min(minx, cx)
            maxx = max(maxx, cx)
            miny = min(miny, cy)
            maxy = max(maxy, cy)
            for nxt, edge in (
                (cur - 1, cx == 0),
                (cur + 1, cx == cols - 1),
                (cur - cols, cy == 0),
                (cur + cols, cy == row_count - 1),
            ):
                if edge or nxt < 0 or nxt >= cols * row_count or seen[nxt] or not grid[nxt]:
                    continue
                seen[nxt] = 1
                stack.append(nxt)
        box_w = (maxx - minx + 1) * step
        box_h = (maxy - miny + 1) * step
        area = count * step * step
        long_side = max(box_w, box_h)
        short_side = min(box_w, box_h)
        if (
            long_side >= minimum
            and short_side >= step
            and area >= minimum * minimum
            and area >= 0.7 * box_w * box_h
        ):
            found.append({"x": minx * step, "y": miny * step, "w": box_w, "h": box_h})
    return found


def white_rects(width, rows, minimum=20):
    cols, grid = white_mask(width, rows)
    return rects_on_grid(cols, grid, minimum)


def neutral_hairline(width, rows, box):
    if min(box["w"], box["h"]) > 4 or not rows or width < 1:
        return False
    channels = len(rows[0]) // width
    x = min(width - 1, box["x"] + box["w"] // 2)
    y = min(len(rows) - 1, box["y"] + box["h"] // 2)
    offset = x * channels
    if offset + 2 >= len(rows[y]):
        return False
    red, green, blue = rows[y][offset], rows[y][offset + 1], rows[y][offset + 2]
    return max(red, green, blue) - min(red, green, blue) <= 12


def other_rects(width, rows):
    width, rows = past_bar(width, rows)

    def keep(region_w, region, box):
        return not neutral_hairline(region_w, region, box)

    found = [box for box in white_rects(width, rows) if keep(width, rows, box)]
    band = 72
    if len(rows) <= band * 2 or width <= band * 2:
        return found
    channels = len(rows[0]) // width

    def strip(x0, x1):
        return [row[x0 * channels : x1 * channels] for row in rows]

    regions = (
        (width, rows[:band]),
        (width, rows[-band:]),
        (band, strip(0, band)),
        (band, strip(width - band, width)),
    )
    for region_w, region in regions:
        found.extend(box for box in white_rects(region_w, region) if keep(region_w, region, box))
    return found


def css_rgb(text):
    if not isinstance(text, str):
        return None
    nums = re.findall(r"\d+", text)
    if len(nums) < 3:
        return None
    return tuple(int(part) for part in nums[:3])


def movie_white(path):
    meta = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            "stream=width,height",
            "-of",
            "csv=p=0",
            str(path),
        ],
        capture_output=True,
        text=True,
    )
    if meta.returncode != 0 or not path.exists():
        return None, (meta.stderr or "no movie").strip()
    try:
        width, height = (int(part) for part in meta.stdout.strip().split(","))
    except ValueError:
        return None, f"bad movie size {meta.stdout.strip()}"
    proc = subprocess.Popen(
        ["ffmpeg", "-v", "error", "-i", str(path), "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
        stdout=subprocess.PIPE,
    )
    frame_bytes = width * height * 3
    hits = []
    frames = 0
    assert proc.stdout is not None
    while True:
        buf = proc.stdout.read(frame_bytes)
        if len(buf) < frame_bytes:
            break
        rows = [buf[y * width * 3 : (y + 1) * width * 3] for y in range(height)]
        boxes = other_rects(width, rows)
        if boxes:
            hits.append((frames, boxes))
        frames += 1
    proc.wait()
    if frames == 0:
        return None, "movie had no frames"
    return {"frames": frames, "hits": hits}, ""


def compile_drag(out):
    source = out / "drag.swift"
    source.write_text(
        """
import CoreGraphics
import Foundation
let args = CommandLine.arguments
guard args.count == 6,
      let x1 = Double(args[1]), let y1 = Double(args[2]),
      let x2 = Double(args[3]), let y2 = Double(args[4]),
      let duration = Double(args[5]) else { exit(2) }
func post(_ type: CGEventType, _ x: Double, _ y: Double) {
  guard let event = CGEvent(mouseEventSource: nil, mouseType: type, mouseCursorPosition: CGPoint(x: x, y: y), mouseButton: .left) else { return }
  event.setIntegerValueField(.mouseEventClickState, value: 1)
  event.post(tap: .cghidEventTap)
}
post(.leftMouseDown, x1, y1)
let steps = 40
let pause = useconds_t(max(1000, duration / Double(steps) * 1_000_000))
for step in 1...steps {
  let u = Double(step) / Double(steps)
  post(.leftMouseDragged, x1 + (x2 - x1) * u, y1 + (y2 - y1) * u)
  usleep(pause)
}
post(.leftMouseUp, x2, y2)
"""
    )
    binary = out / "drag"
    proc = subprocess.run(["swiftc", "-O", "-o", str(binary), str(source)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or "drag swiftc failed")
    return binary


def record_window(window, path, seconds):
    path.unlink(missing_ok=True)
    proc = subprocess.run(
        ["screencapture", "-l", str(window), "-V", str(seconds), "-o", str(path)],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0 or not path.exists() or path.stat().st_size < 1000:
        raise RuntimeError(proc.stderr or proc.stdout or "screencapture video failed")


def flash_book(out, window_tool, mouse, drag, book):
    if spike_pids():
        return False, "another spike-shell is running", None
    saved = read_settings()
    write_trim("paperback")
    log = out / f"flash-{book}.log"
    handle = log.open("w")
    proc = subprocess.Popen(
        [str(release_bin("spike-shell"))],
        env=child_env({"SPIKE_MODE": "webkit", "SPIKE_BOOK": book}),
        stdout=handle,
        stderr=subprocess.STDOUT,
        cwd=SPIKES,
    )
    handle.close()
    metrics = None
    deadline = time.time() + 8
    try:
        while time.time() < deadline:
            if proc.poll() is not None:
                return False, f"{book} exited before a window", log.name
            metrics = window_metrics(window_tool, proc.pid)
            if metrics is not None:
                break
            time.sleep(0.02)
        if metrics is None:
            return False, f"{book} never showed a window", log.name
        park_mouse(mouse, metrics["screen_h"])
        # The lights fade after the pointer leaves. The open recording starts
        # once they are gone, so a pointer left on the title bar is not a flash.
        time.sleep(0.6)
        phases = []
        open_mov = out / f"flash-{book}-open.mov"
        record_window(metrics["id"], open_mov, 2.2)
        phases.append(("open", open_mov))
        latest = window_metrics(window_tool, proc.pid) or metrics
        drag_mov = out / f"flash-{book}-drag.mov"
        drag_proc = subprocess.Popen(
            ["screencapture", "-l", str(latest["id"]), "-V", "2.4", "-o", str(drag_mov)]
        )
        time.sleep(0.25)
        if "x" in latest:
            x1 = latest["x"] + latest["w"] - 5
            y1 = latest["y"] + latest["h"] - 5
            subprocess.run(
                [str(drag), str(x1), str(y1), str(x1 + 180), str(y1 + 220), "1.0"],
                capture_output=True,
            )
        drag_proc.wait(timeout=8)
        if not drag_mov.exists():
            return False, f"{book} drag recording missing", log.name
        phases.append(("drag", drag_mov))
        latest = window_metrics(window_tool, proc.pid) or latest
        frame_mov = out / f"flash-{book}-setframe.mov"
        frame_proc = subprocess.Popen(
            ["screencapture", "-l", str(latest["id"]), "-V", "2.6", "-o", str(frame_mov)]
        )
        time.sleep(0.2)
        write_trim("trade")
        time.sleep(1.2)
        write_trim("paperback")
        frame_proc.wait(timeout=8)
        if not frame_mov.exists():
            return False, f"{book} setFrame recording missing", log.name
        phases.append(("setframe", frame_mov))
    finally:
        stop(proc)
        if saved is None:
            SETTINGS.unlink(missing_ok=True)
        else:
            SETTINGS.write_text(saved)
    bad = []
    scanned = []
    for name, movie in phases:
        report, err = movie_white(movie)
        if report is None:
            return False, f"{book} {name} {err}", movie.name
        scanned.append(f"{name} {report['frames']}")
        if report["hits"]:
            box = report["hits"][0][1][0]
            bad.append(f"{name} frame {report['hits'][0][0]} {box['w']}x{box['h']} at {box['x']},{box['y']}")
    detail = ", ".join(scanned)
    if bad:
        return False, detail + "; " + "; ".join(bad), phases[0][1].name
    return True, detail + "; no other color", phases[0][1].name


def run_flash(out, window_tool):
    clear_bar_hooks()
    mouse = compile_mouse(out)
    drag = compile_drag(out)
    rows = []
    for book in ("pride", "zhaohua"):
        ok, detail, evidence = flash_book(out, window_tool, mouse, drag, book)
        rows.append(
            check(
                f"flash-{book}",
                "window-chrome",
                "window",
                "pass" if ok else "fail",
                detail,
                evidence,
            )
        )
    return rows


def aqua_appearance(name):
    text = str(name or "")
    return "Aqua" in text and "Dark" not in text


def toolbar_dark_on_white(width, rows):
    """The toolbar title and the contents icon are dark, and the top band's paper is #ffffff.

    A vanished template icon is near white. The rounded corners of the capture
    are black and sit outside these bands.
    """
    height = len(rows)
    if not rows or width < 80 or height < 40:
        return False, "shot too small"
    channels = len(rows[0]) // width

    def neutral_dark(row, x):
        offset = x * channels
        if offset + 2 >= len(row):
            return False
        red, green, blue = row[offset], row[offset + 1], row[offset + 2]
        return max(red, green, blue) <= 160 and max(red, green, blue) - min(red, green, blue) <= 18

    glyphs = 0
    x0 = int(width * 0.30)
    x1 = int(width * 0.70)
    for y in range(16, min(72, height)):
        row = rows[y]
        for x in range(x0, x1):
            if neutral_dark(row, x):
                glyphs += 1
    icon = 0
    # The contents icon sits just past the zoom button, clear of the lights.
    ix0 = int(width * 0.14)
    ix1 = int(width * 0.28)
    for y in range(16, min(72, height)):
        row = rows[y]
        for x in range(ix0, ix1):
            if neutral_dark(row, x):
                icon += 1
    paper_bad = 0
    paper_n = 0
    px0 = int(width * 0.72)
    px1 = int(width * 0.92)
    for y in range(8, min(28, height)):
        row = rows[y]
        for x in range(px0, px1, 3):
            offset = x * channels
            if offset + 2 >= len(row):
                continue
            paper_n += 1
            if not near_white(row[offset], row[offset + 1], row[offset + 2]):
                paper_bad += 1
    ok = glyphs >= 40 and icon >= 40 and paper_n > 0 and paper_bad == 0
    return ok, f"title glyphs {glyphs}, icon glyphs {icon}, paper off {paper_bad} of {paper_n}"


def rect_of(body, key):
    rect = body.get(key) if isinstance(body, dict) else None
    if not isinstance(rect, dict):
        return None
    try:
        return {name: float(rect[name]) for name in ("x", "y", "w", "h")}
    except (KeyError, TypeError, ValueError):
        return None


def rects_intersect(one, other):
    return (
        one["x"] < other["x"] + other["w"]
        and other["x"] < one["x"] + one["w"]
        and one["y"] < other["y"] + other["h"]
        and other["y"] < one["y"] + one["h"]
    )


def icon_placement(body):
    """The contents item sits 26 pt past the zoom button and clear of the lights."""
    icon = rect_of(body, "icon_frame")
    names = ("close", "miniaturize", "zoom")
    lights = [rect_of(body, name) for name in names]
    zoom = lights[2]
    if icon is None or zoom is None or any(rect is None for rect in lights):
        return False, "missing icon frame"
    gap = icon["x"] - (zoom["x"] + zoom["w"])
    dy = (icon["y"] + icon["h"] / 2.0) - (zoom["y"] + zoom["h"] / 2.0)
    hits = [name for name, rect in zip(names, lights) if rects_intersect(icon, rect)]
    ok = abs(gap - 26.0) <= 0.5 and abs(dy) <= 0.5 and not hits
    detail = f"gap {gap:.1f} dy {dy:.1f}"
    if hits:
        detail += " intersects " + ",".join(hits)
    return ok, detail


def system_is_dark():
    proc = subprocess.run(
        ["defaults", "read", "-g", "AppleInterfaceStyle"],
        capture_output=True,
        text=True,
    )
    return proc.returncode == 0 and "Dark" in proc.stdout


def set_system_dark(dark):
    word = "true" if dark else "false"
    proc = subprocess.run(
        [
            "osascript",
            "-e",
            f'tell application "System Events" to tell appearance preferences to set dark mode to {word}',
        ],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout or "could not set dark mode").strip())
    deadline = time.time() + 8
    while time.time() < deadline:
        if system_is_dark() == bool(dark):
            time.sleep(0.4)
            return
        time.sleep(0.2)
    raise RuntimeError(f"dark mode did not become {dark}")


def wait_icon(started, timeout=8):
    deadline = time.time() + timeout
    last = {}
    detail = "missing icon frame"
    while time.time() < deadline:
        body = chrome_body(started) or {}
        if isinstance(body, dict):
            last = body
        placed, detail = icon_placement(last)
        shown = float(last.get("lights") or 0) >= 0.9
        if placed and shown:
            return last, detail
        time.sleep(0.15)
    return last, detail


def aqua_case(out, window_tool, ocr_tool, mouse, name, dark):
    check_id = "window-aqua" if dark else "window-aqua-light"
    state = launch(
        out,
        name,
        child_env({"SPIKE_MODE": "webkit", "SPIKE_BOOK": "pride"}),
        lambda names: False,
        35,
        lambda started: chrome_ready(started, "pride", False, None),
    )
    png = out / f"{name}.png"
    try:
        if not state["alive"]:
            return check(check_id, "window-chrome", "window", "fail", f"{name} exited")
        metrics = None
        for _ in range(8):
            metrics = window_metrics(window_tool, state["pid"])
            if metrics:
                break
            time.sleep(0.2)
        if not metrics:
            return check(check_id, "window-chrome", "window", "fail", "no window")
        reveal_lights(mouse, metrics)
        body, place = wait_icon(state["started"])
        capture(metrics["id"], png)
        appearance = body.get("appearance") if isinstance(body, dict) else None
        width, _height, rows = decode_png_rows(png)
        pixels_ok, pixel_detail = toolbar_dark_on_white(width, rows)
        placed, _ = icon_placement(body)
        ok = pixels_ok and aqua_appearance(appearance) and placed
        mode = "dark" if dark else "light"
        detail = f"{mode} appearance {appearance}; {place}; {pixel_detail}"
        if dark and png.exists():
            shots = ROOT / "docs" / "verify" / "aqua"
            shots.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(png, shots / "after-dark.png")
        return check(
            check_id,
            "window-chrome",
            "window",
            "pass" if ok else "fail",
            detail,
            png.name if png.exists() else None,
        )
    except Exception as exc:
        return check(check_id, "window-chrome", "window", "fail", str(exc))
    finally:
        finish_launch(state)


def run_aqua(out, window_tool, ocr_tool):
    mouse = compile_mouse(out)
    was_dark = system_is_dark()
    rows = []
    try:
        set_system_dark(True)
        rows.append(aqua_case(out, window_tool, ocr_tool, mouse, "aqua-dark", True))
        set_system_dark(False)
        rows.append(aqua_case(out, window_tool, ocr_tool, mouse, "aqua-light", False))
        return rows
    except Exception as exc:
        if not rows:
            rows.append(check("window-aqua", "window-chrome", "window", "fail", str(exc)))
        rows.append(check("window-aqua-light", "window-chrome", "window", "fail", str(exc)))
        return rows
    finally:
        try:
            set_system_dark(was_dark)
        except Exception as exc:
            print(f"could not restore appearance: {exc}", file=sys.stderr)


def run_chrome(out, window_tool, ocr_tool):
    clear_bar_hooks()
    rows = []
    proto = ROOT / "docs" / "prototypes" / "window-chrome"
    proto.mkdir(parents=True, exist_ok=True)
    mouse = compile_mouse(out)
    saved = read_settings()
    shots = [
        ("b-pride", {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "pride"}, "pride", False, "hide", True),
        ("b-pride-hover", {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "pride"}, "pride", False, "show", False),
        ("b-zhaohua", {"SPIKE_MODE": "webkit", "SPIKE_BOOK": "zhaohua", "SPIKE_AT": "3"}, "zhaohua", False, "hide", False),
        ("b-pride-fullscreen", {"SPIKE_FULLSCREEN": "1", "SPIKE_MODE": "webkit", "SPIKE_BOOK": "pride"}, "pride", True, None, False),
    ]
    try:
        write_trim("paperback")
        for name, env, book, fullscreen, lights, measure in shots:
            state, metrics, lines, body = chrome_shot(out, window_tool, ocr_tool, mouse, name, env, book, fullscreen, lights)
            try:
                png = out / f"{name}.png"
                if png.exists():
                    shutil.copyfile(png, proto / f"{name}.png")
                if measure:
                    ratio_w, ratio_h = TRIMS["paperback"]
                    if isinstance(body, dict) and metrics:
                        ok, detail = chrome_aspect_detail(metrics, ratio_w, ratio_h)
                        clear = chrome_clear(body)
                        footer = footer_ok(lines, png)
                        web = webkit_body(state["started"]) or {}
                        filled, fill_detail = column_filled(web)
                        aligned, align_detail = footer_on_measure(web)
                        rows.append(check("chrome-b-aspect", "window-chrome", "window", "pass" if ok else "fail", detail, f"{name}.png"))
                        rows.append(check(
                            "chrome-b-clear",
                            "window-chrome",
                            "window",
                            "pass" if clear else "fail",
                            f"page top {float(body.get('page_y') or 0):.0f} clears the traffic lights",
                            f"{name}.png",
                        ))
                        rows.append(check(
                            "chrome-b-footer",
                            "window-chrome",
                            "window",
                            "pass" if footer else "fail",
                            "footer visible" if footer else "footer missing from the picture",
                            f"{name}.png",
                        ))
                        div_count, div_detail = gap_divider_count(png, body, web)
                        rows.append(check(
                            "footer-no-divider",
                            "window-chrome",
                            "window",
                            "pass" if div_count == 0 else "fail",
                            div_detail,
                            f"{name}.png",
                        ))
                        rows.append(check(
                            "chrome-b-fill",
                            "window-chrome",
                            "window",
                            "pass" if filled else "fail",
                            fill_detail,
                            f"{name}.png",
                        ))
                        rows.append(check(
                            "chrome-b-measure",
                            "window-chrome",
                            "window",
                            "pass" if aligned else "fail",
                            align_detail,
                            f"{name}.png",
                        ))
                        items = body.get("items")
                        order_ok = items == [
                            "books.contents",
                            "books.bookmarks",
                            "books.search",
                            "books.add-bookmark",
                            "books.notes",
                            "books.immersive",
                        ]
                        rows.append(check(
                            "chrome-b-toolbar-order",
                            "window-chrome",
                            "window",
                            "pass" if order_ok else "fail",
                            " ".join(items) if isinstance(items, list) else "toolbar items were not reported",
                            f"{name}.png",
                        ))
                        font = str(web.get("footer_font") or "")
                        variant = str(web.get("footer_variant") or "")
                        lowered = font.lower()
                        font_ok = bool(font) and "iowan" not in lowered and "songti" not in lowered and (
                            "apple" in lowered or "sf " in lowered or "system" in lowered
                        ) and "tabular" in variant
                        rows.append(check(
                            "chrome-b-footer-font",
                            "window-chrome",
                            "window",
                            "pass" if font_ok else "fail",
                            f"footer font {font or 'missing'} variant {variant or 'missing'}",
                            f"{name}.png",
                        ))
                        write_trim("trade")
                        switched = False
                        deadline = time.time() + 8
                        while time.time() < deadline:
                            fresh = window_metrics(window_tool, state["pid"])
                            later = chrome_body(state["started"]) or {}
                            if fresh and abs(float(later.get("ratio_w") or 0) - 140) < 1:
                                trade_ok, trade_detail = chrome_aspect_detail(fresh, 140, 216)
                                if trade_ok:
                                    switched = True
                                    rows.append(check("chrome-b-trim", "window-chrome", "window", "pass", trade_detail))
                                    break
                            time.sleep(0.3)
                        if not switched:
                            rows.append(check("chrome-b-trim", "window-chrome", "window", "fail", "trade trim did not resize the window"))
                        write_trim("paperback")
                    else:
                        rows.append(check("chrome-b-aspect", "window-chrome", "window", "fail", str(body)))
                        rows.append(check("chrome-b-clear", "window-chrome", "window", "fail", str(body)))
                        rows.append(check("chrome-b-footer", "window-chrome", "window", "fail", str(body)))
                        rows.append(check("footer-no-divider", "window-chrome", "window", "fail", "no window"))
                        rows.append(check("chrome-b-fill", "window-chrome", "window", "fail", "no window"))
                        rows.append(check("chrome-b-measure", "window-chrome", "window", "fail", "no window"))
                        rows.append(check("chrome-b-toolbar-order", "window-chrome", "window", "fail", "no window"))
                        rows.append(check("chrome-b-footer-font", "window-chrome", "window", "fail", "no window"))
                        rows.append(check("chrome-b-trim", "window-chrome", "window", "fail", "no window"))
                elif book == "zhaohua" and not png.exists():
                    rows.append(check("chrome-b-zhaohua-footer", "window-chrome", "window", "fail", str(body)))
                elif fullscreen and not png.exists():
                    rows.append(check("chrome-b-fullscreen-footer", "window-chrome", "window", "fail", str(body)))
                    rows.append(check("chrome-b-fullscreen-page", "window-chrome", "window", "fail", str(body)))
                    rows.append(check("chrome-b-fullscreen-paper", "window-chrome", "window", "fail", str(body)))
                if png.exists() and book == "zhaohua":
                    footer = footer_ok(lines, png)
                    rows.append(check(
                        "chrome-b-zhaohua-footer",
                        "window-chrome",
                        "window",
                        "pass" if footer else "fail",
                        "footer visible" if footer else "footer missing from the picture",
                        f"{name}.png",
                    ))
                if png.exists() and fullscreen and isinstance(body, dict):
                    footer = footer_ok(lines, png)
                    rows.append(check(
                        "chrome-b-fullscreen-footer",
                        "window-chrome",
                        "window",
                        "pass" if footer else "fail",
                        "footer visible" if footer else "footer missing from the picture",
                        f"{name}.png",
                    ))
                    stage_w = float(body.get("stage_w") or 0)
                    stage_h = float(body.get("stage_h") or 0)
                    want_x, want_y, want_w, want_h = placed_page(stage_w, stage_h, *TRIMS["paperback"])
                    bar_w = float(body.get("bar_w") or 0)
                    if bar_w > 1 and bar_w + want_w <= stage_w:
                        want_x = bar_w + (stage_w - bar_w - want_w) / 2.0
                    page_x = float(body.get("page_x") or 0)
                    page_y = float(body.get("page_y") or 0)
                    page_w = float(body.get("page_w") or 0)
                    page_h = float(body.get("page_h") or 0)
                    placed = (
                        abs(page_x - want_x) <= 8
                        and abs(page_y - want_y) <= 8
                        and abs(page_w - want_w) <= 8
                        and abs(page_h - want_h) <= 8
                    )
                    web = webkit_body(state["started"]) or {}
                    plan_w, _plan_h = chrome_plan(*TRIMS["paperback"], metrics["vis_w"], metrics["vis_h"]) if metrics else (0, 0)
                    design_w = plan_w - CHROME_SIDE * 2
                    view_w = float(web.get("view_w") or 0)
                    scaled = design_w > 1 and abs(view_w - design_w) <= 12
                    aligned, align_detail = footer_on_measure(web)
                    rows.append(check(
                        "chrome-b-fullscreen-page",
                        "window-chrome",
                        "window",
                        "pass" if placed and scaled and aligned else "fail",
                        (
                            f"page {page_w:.0f}x{page_h:.0f} at {page_x:.0f},{page_y:.0f} "
                            f"want {want_w:.0f}x{want_h:.0f} at {want_x:.0f},{want_y:.0f}, "
                            f"css width {view_w:.0f} design {design_w:.0f}, {align_detail}"
                        ),
                        f"{name}.png",
                    ))
                    width, _height, pixels = decode_png_rows(png)
                    window_w = float(body.get("window_w") or body.get("stage_w") or 0)
                    skip = int(round(float(body.get("bar_w") or 0) * width / window_w)) if window_w else 0
                    paper_ok, paper_detail = top_is_paper(width, pixels, skip_px=skip)
                    rows.append(check(
                        "chrome-b-fullscreen-paper",
                        "window-chrome",
                        "window",
                        "pass" if paper_ok else "fail",
                        paper_detail,
                        f"{name}.png",
                    ))
                if lights == "show":
                    fresh = chrome_body(state["started"]) or {}
                    shown = png.exists() and float(fresh.get("lights") or 0) >= 0.9
                    rows.append(check(
                        "chrome-b-hover",
                        "window-chrome",
                        "window",
                        "pass" if shown else "fail",
                        "lights shown" if shown else "hover chrome did not appear",
                        f"{name}.png" if png.exists() else None,
                    ))
            finally:
                if state:
                    finish_launch(state)
    finally:
        if saved is None:
            SETTINGS.unlink(missing_ok=True)
        else:
            SETTINGS.parent.mkdir(parents=True, exist_ok=True)
            SETTINGS.write_text(saved)
    return rows


def pending_rows():
    return [check(check_id, feature, "none", "pending", detail) for check_id, feature, detail in PENDING]


