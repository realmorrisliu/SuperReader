        ("reading-page-ready", "reading-view", "window"),
        ("pdf-open-to-first", "reading-bars", "measure"),
        ("pdf-later-page", "reading-bars", "measure"),
    ]
    return [check(check_id, feature, driver, "fail", reason) for check_id, feature, driver in ids]


def write_summary(out, rows, version):
    failing = [row for row in rows if row["status"] == "fail"]
    summary = {
        "ok": not failing,
        "nsh": version,
        "loadavg": loadavg(),
        "checks": rows,
    }
    path = out / "summary.json"
    path.write_text(json.dumps(summary, indent=2) + "\n")
    for row in rows:
        print(f"{row['status']} {row['id']} {row['detail']}")
    print(path)
    return 1 if failing else 0


def main():
    parser = argparse.ArgumentParser(description="Score the SuperReader spike.")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--doctor", action="store_true")
    args = parser.parse_args()
    if args.doctor:
        rows = doctor()
        for row in rows:
            print(f"{row['status']} {row['id']} {row['detail']}")
        return 1 if any(row["status"] == "fail" for row in rows) else 0
    if args.self_test:
        self_test()
        print("self-test passed")
        return 0
    try:
        self_test()
    except Exception as exc:
        print(f"self-test failed: {exc}", file=sys.stderr)
        return 1
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    out = args.out or (ROOT / "docs" / "verify" / "runs" / stamp)
    if not out.is_absolute():
        out = ROOT / out
    out.mkdir(parents=True, exist_ok=True)
    version = nsh_version()
    rows = doctor()
    if any(row["status"] == "fail" for row in rows):
        rows.extend(skipped("not run because doctor failed"))
        rows.extend(pending_rows())
        return write_summary(out, rows, version)
    built = build(out / "build.log")
    rows.append(built)
    if built["status"] == "fail":
        rows.extend(skipped("not run because the release build failed"))
        rows.extend(pending_rows())
        return write_summary(out, rows, version)
    try:
        rows.extend(run_nsh(out))
    except subprocess.TimeoutExpired:
        rows.append(check("nsh-title", "reading-bars", "nsh", "fail", "nsh test timed out"))
    try:
        tool = compile_window_id(out)
        ocr_tool = compile_ocr(out)
        rows.extend(run_windows(out, tool, ocr_tool))
    except Exception as exc:
        rows.append(check("pdf-title", "open-a-pdf", "window", "fail", str(exc)))
    try:
        rows.extend(run_reading(out, tool, ocr_tool))
    except Exception as exc:
        rows.append(check("trim-32kai-pride", "reading-view", "window", "fail", str(exc)))
    rows.extend(run_measure(out))
    rows.extend(pending_rows())
    return write_summary(out, rows, version)


if __name__ == "__main__":
    sys.exit(main())
