        ("immersive-roundtrip", "floating-card", "window"),
    ]
    return [check(check_id, feature, driver, "fail", reason) for check_id, feature, driver in ids]


LOCK_DIR = Path("/tmp/superreader-verify.lock")


def hold_verify_lock():
    """Serialize verify runs. mkdir is the lock. A dead holder's directory is removed."""
    import atexit

    def release():
        if not LOCK_DIR.is_dir():
            return
        pid_path = LOCK_DIR / "pid"
        try:
            owner = pid_path.read_text().strip()
        except OSError:
            owner = ""
        if owner != str(os.getpid()):
            return
        for name in ("pid", "branch", "started"):
            (LOCK_DIR / name).unlink(missing_ok=True)
        try:
            LOCK_DIR.rmdir()
        except OSError:
            pass

    while True:
        if LOCK_DIR.is_dir():
            try:
                owner = int((LOCK_DIR / "pid").read_text().strip())
            except (OSError, ValueError):
                owner = None
            if owner is not None and not Path(f"/proc/{owner}").exists():
                try:
                    os.kill(owner, 0)
                except OSError:
                    print(f"clearing stale verify lock (pid {owner})", flush=True)
                    for name in ("pid", "branch", "started"):
                        (LOCK_DIR / name).unlink(missing_ok=True)
                    try:
                        LOCK_DIR.rmdir()
                    except OSError:
                        pass
        try:
            LOCK_DIR.mkdir()
        except FileExistsError:
            print("waiting for verify lock", flush=True)
            time.sleep(30)
            continue
        break
    (LOCK_DIR / "pid").write_text(f"{os.getpid()}\n")
    branch = subprocess.run(
        ["git", "branch", "--show-current"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    (LOCK_DIR / "branch").write_text((branch.stdout or "unknown").strip() + "\n")
    (LOCK_DIR / "started").write_text(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + "\n")
    atexit.register(release)
    while True:
        load = one_minute_load()
        ceiling = load_ceiling()
        if load < ceiling:
            print(f"verify starting: 1m loadavg={load:.2f}", flush=True)
            while True:
                held = subprocess.run(["pgrep", "-fl", "/spike-shell$"], capture_output=True, text=True)
                if held.returncode != 0:
                    break
                print("waiting for spike-shell to exit", flush=True)
                time.sleep(30)
            return load
        print(f"waiting for load < {ceiling} (now {load:.2f})", flush=True)
        time.sleep(30)


def load_ceiling():
    raw = os.environ.get("SR_VERIFY_MAX_LOAD", "8").strip() or "8"
    try:
        return float(raw)
    except ValueError:
        return 8.0


def one_minute_load():
    proc = subprocess.run(["sysctl", "-n", "vm.loadavg"], capture_output=True, text=True)
    if proc.returncode == 0 and proc.stdout.strip():
        text = proc.stdout.replace("{", "").replace("}", "").strip()
        return float(text.split()[0])
    return os.getloadavg()[0]


def write_summary(out, rows, version, load_start):
    failing = [row for row in rows if row["status"] == "fail"]
    summary = {
        "ok": not failing,
        "nsh": version,
        "load_start": load_start,
        "load_end": one_minute_load(),
        "loadavg": loadavg(),
        "top": RUN_TOP or top_cpu(),
        "warm_phases": WARM_PHASES,
        "checks": rows,
    }
    path = out / "summary.json"
    path.write_text(json.dumps(summary, indent=2) + "\n")
    for row in rows:
        print(f"{row['status']} {row['id']} {row['detail']}")
    print(path)
    return 1 if failing else 0


BOLD_PROBES = (
    "a",
    "be",
    "ma",
    "go",
    "tru",
    "si",
    "for",
    "ente",
    "char",
    "exper",
    "unive",
    "acknow",
    "unders",
    "charact",
    "represe",
)
MAIN_SHELL = Path("/tmp/spike-shell-main-fdd8183")


def png_pixel_diff(left, right):
    left_w, left_h, left_rows = decode_png_rows(left)
    right_w, right_h, right_rows = decode_png_rows(right)
    if (left_w, left_h) != (right_w, right_h):
        return f"size {left_w}x{left_h} against {right_w}x{right_h}"
    return row_pixel_diff(left_rows, right_rows)


def row_pixel_diff(left_rows, right_rows):
    differ = 0
    for one, other in zip(left_rows, right_rows):
        if one == other:
            continue
        differ += sum(1 for i in range(0, len(one), 4) if one[i : i + 4] != other[i : i + 4])
    return differ


# The page rectangle reaches the window's rounded corner once the bar shifts it
# right. That corner is the window, not the page.
PAGE_CORNER_PT = 8.0


def page_rows(png, body, inset=0.0):
    width, height, rows = decode_png_rows(png)
    try:
        stage = float(body.get("stage_w") or 0)
        x = float(body["page_x"])
        y = float(body["page_y"])
        page_w = float(body["page_w"])
        page_h = float(body["page_h"])
    except (TypeError, ValueError, KeyError):
        return None
    if stage <= 0 or page_w <= 1 or page_h <= 1:
        return None
    if page_w > inset * 2 + 1 and page_h > inset * 2 + 1:
        x += inset
        y += inset
        page_w -= inset * 2
        page_h -= inset * 2
    scale = width / stage
    left = int(round(x * scale))
    top = int(round(y * scale))
    crop_w = int(round(page_w * scale))
    crop_h = int(round(page_h * scale))
    if left < 0 or top < 0 or crop_w < 1 or crop_h < 1:
        return None
    if left + crop_w > width or top + crop_h > height:
        return None
    channels = len(rows[0]) // width
    cropped = [
        row[left * channels : (left + crop_w) * channels] for row in rows[top : top + crop_h]
    ]
    return crop_w, crop_h, cropped


def page_pixel_diff(left_png, left_body, right_png, right_body):
    """Compare the page bitmaps. The traffic-light bar sits outside the page, so a
    whole-window diff against a shell without the bar is not the bold-off check."""
    left = page_rows(left_png, left_body, PAGE_CORNER_PT)
    right = page_rows(right_png, right_body, PAGE_CORNER_PT)
    if left is None or right is None:
        return "page box missing"
    if (left[0], left[1]) != (right[0], right[1]):
        return f"page {left[0]}x{left[1]} against {right[0]}x{right[1]}"
    return row_pixel_diff(left[2], right[2])


# Latin face margin_bottom. The gray system footer lives in this band.
# The fdd8183 baseline still has the serif footer, so bold-off compares
# everything above the band and leaves the band to the new footer.
FOOTER_BAND_PT = 72.0


def footer_band_rows(body, png_width, inset, footer_pt):
    try:
        stage = float(body.get("stage_w") or 0)
        page_w = float(body["page_w"])
        page_h = float(body["page_h"])
    except (TypeError, ValueError, KeyError):
        return None
    if stage <= 0 or png_width <= 0:
        return None
    applied = inset if page_w > inset * 2 + 1 and page_h > inset * 2 + 1 else 0.0
    visible = footer_pt - applied
    if visible <= 0:
        return 0
    return int(round(visible * png_width / stage))


def bold_off_page_diff(left_png, left_body, right_png, right_body, footer_pt=FOOTER_BAND_PT):
    """Exact page match against the baseline above the footer band.

    The system-font footer is the reference inside that band, so those pixels
    are not scored against the serif baseline. A prefix, or any other change
    above the band, still counts. `page_pixel_diff` stays exact.
    """
    left = page_rows(left_png, left_body, PAGE_CORNER_PT)
    right = page_rows(right_png, right_body, PAGE_CORNER_PT)
    if left is None or right is None:
        return "page box missing"
    if (left[0], left[1]) != (right[0], right[1]):
        return f"page {left[0]}x{left[1]} against {right[0]}x{right[1]}"
    left_w, _, _ = decode_png_rows(left_png)
    right_w, _, _ = decode_png_rows(right_png)
    left_band = footer_band_rows(left_body, left_w, PAGE_CORNER_PT, footer_pt)
    right_band = footer_band_rows(right_body, right_w, PAGE_CORNER_PT, footer_pt)
    if left_band is None or right_band is None or left_band != right_band:
        return "footer band missing"
    if left_band >= left[1]:
        return "footer band covers the page"
    if left_band:
        left_rows = left[2][: left[1] - left_band]
        right_rows = right[2][: right[1] - right_band]
    else:
        left_rows = left[2]
        right_rows = right[2]
    return row_pixel_diff(left_rows, right_rows)


def grab_page(state, window_tool, png):
    if not state["alive"]:
        return False
    wait_json(state["started"], layout_settled, 20)
    time.sleep(0.4)
    wid = window_id(window_tool, state["pid"])
    if not wid:
        return False
    capture(wid, png)
    return png.exists() and png.stat().st_size > 1000


def bold_word_starts(out, window_tool):
    rows = []
    write_trim("paperback")
    clear_breaks()
    env = {"SPIKE_MODE": "webkit", "SPIKE_SELECT": "1"}
    off_png = out / "bold-off.png"
    main_png = out / "bold-main.png"
    off = launch(
        out,
        "bold-off",
        child_env(env),
        lambda names: False,
        45,
        lambda started: chapter_ready(started, "pride"),
    )
    try:
        grabbed = grab_page(off, window_tool, off_png)
        off_body = webkit_body(off["started"]) or {}
        off_box = chrome_pid_body(off["started"], off["pid"]) or read_chrome(
            CHROME_JSON, off["started"]
        ) or {}
    finally:
        finish_launch(off)
    clear_breaks()
    main_box = {}
    if MAIN_SHELL.exists():
        baseline = launch(
            out,
            "bold-main",
            child_env(env),
            lambda names: False,
            45,
            lambda started: chapter_ready(started, "pride"),
            MAIN_SHELL,
        )
        try:
            grabbed = grab_page(baseline, window_tool, main_png) and grabbed
            main_box = read_chrome(CHROME_JSON, baseline["started"]) or {}
        finally:
            finish_launch(baseline)
    else:
        grabbed = False
    prefixes = off_body.get("bold_prefixes")
    dom_off = prefixes == []
    if not MAIN_SHELL.exists():
        pixel = "baseline binary is missing"
    elif not grabbed:
        pixel = "a window capture is missing"
    else:
        pixel = bold_off_page_diff(off_png, off_box, main_png, main_box)
    off_ok = dom_off and pixel == 0
    rows.append(
        check(
            "bold-word-starts-off",
            "bold-word-starts",
            "window",
            "pass" if off_ok else "fail",
            f"prefixes {prefixes} pixels {pixel} above the {FOOTER_BAND_PT:.0f}pt footer",
            "bold-off.png",
        )
    )
    SETTINGS.write_text('{"trim":"paperback","boldWordStarts":true}\n')
    clear_breaks()
    on = launch(
        out,
        "bold-on",
        child_env({**env, "SPIKE_BOLD_PROBES": "1"}),
        lambda names: False,
        45,
        lambda started: chapter_ready(started, "pride"),
    )
    try:
        on_body = webkit_body(on["started"]) or {}
    finally:
        finish_launch(on)
    got = on_body.get("bold_prefixes")
    rows.append(
        check(
            "bold-word-starts-on",
            "bold-word-starts",
            "window",
            "pass" if got == list(BOLD_PROBES) else "fail",
            f"prefixes {got}",
        )
    )
    write_trim("paperback")
    clear_breaks()
    return rows


def write_bold(on):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps({"trim": "paperback", "boldWordStarts": on}) + "\n")


def settled_pride(started):
    body = webkit_body(started)
    return (
        body is not None
        and isinstance(body.get("page_ready_ms"), (int, float))
        and layout_settled(body)
        and chapter_ready(started, "pride")
    )


def mode_facts(body):
    layout = layout_of(body) or {}
    pages = body.get("pages")
    count = pages[1] if isinstance(pages, list) and len(pages) == 2 else None
    overflow = layout.get("overflow_lines")
    live = layout.get("live_calls")
    return {
        "source": layout.get("break_source"),
        "live": live,
        "overflow": overflow,
        "pages": count,
    }


def bold_break_cache(out):
    reap_our_shells()
    clear_breaks()
    write_bold(False)
    timed_open(out, "bold-cache-off-prime", True, {}, settled_pride, 60)
    off_cached = mode_facts(timed_open(out, "bold-cache-off-cached", True, {}, settled_pride, 60))
    write_bold(True)
    on_live = mode_facts(timed_open(out, "bold-cache-on-live", True, {}, settled_pride, 60))
    on_cached = mode_facts(timed_open(out, "bold-cache-on-cached", True, {}, settled_pride, 60))
    write_bold(False)
    off_live = mode_facts(timed_open(out, "bold-cache-off-live", True, {}, settled_pride, 60))
    off_again = mode_facts(timed_open(out, "bold-cache-off-again", True, {}, settled_pride, 60))
    write_trim("paperback")
    clear_breaks()

    def fresh(facts):
        live = facts["live"]
        return facts["source"] == "live" and isinstance(live, (int, float)) and live > 0 and facts["overflow"] in (0, 0.0)

    def reused(facts, live_facts):
        return (
            facts["source"] == "cached"
            and facts["live"] == 0
            and facts["overflow"] in (0, 0.0)
            and facts["overflow"] == live_facts["overflow"]
            and facts["pages"] == live_facts["pages"]
            and isinstance(facts["pages"], int)
            and facts["pages"] > 1
        )

    ok = (
        off_cached["source"] == "cached"
        and off_cached["live"] == 0
        and fresh(on_live)
        and reused(on_cached, on_live)
        and fresh(off_live)
        and reused(off_again, off_live)
        and off_live["pages"] == off_cached["pages"] == off_again["pages"]
    )
    return check(
        "bold-word-starts-cache",
        "bold-word-starts",
        "window",
        "pass" if ok else "fail",
        f"off cached {off_cached} on live {on_live} on cached {on_cached} "
        f"off live {off_live} off again {off_again}",
    )


def compile_swift(out, name, source):
    path = out / f"{name}.swift"
    path.write_text(source)
    binary = out / name
    proc = subprocess.run(["swiftc", "-o", str(binary), str(path)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr or f"{name} swiftc failed")
    return binary


def run_bar(out, window_tool):
    rows = []

    def row(name, ok, detail):
        rows.append(check(name, "sidebar", "window", "pass" if ok else "fail", detail))

    def card_row(name, ok, detail, evidence=None):
        rows.append(check(name, "floating-card", "window", "pass" if ok else "fail", detail, evidence))

    lights = compile_swift(
        out,
        "shell-lights",
        """
import AppKit
import ApplicationServices
import CoreGraphics
guard CommandLine.arguments.count > 1, let pid = pid_t(CommandLine.arguments[1]) else { exit(2) }
let app = AXUIElementCreateApplication(pid)
var raw: CFTypeRef?
guard AXUIElementCopyAttributeValue(app, kAXWindowsAttribute as CFString, &raw) == .success,
      let windows = raw as? [AXUIElement], !windows.isEmpty else {
  fputs("no window\\n", stderr)
  exit(1)
}
func axValue(_ el: AXUIElement, _ name: String) -> CFTypeRef? {
  var value: CFTypeRef?
  guard AXUIElementCopyAttributeValue(el, name as CFString, &value) == .success else { return nil }
  return value
}
func box(_ el: AXUIElement) -> (CGFloat, CGFloat, CGFloat, CGFloat)? {
  guard let p = axValue(el, kAXPositionAttribute as String),
        let s = axValue(el, kAXSizeAttribute as String),
        CFGetTypeID(p) == AXValueGetTypeID(),
        CFGetTypeID(s) == AXValueGetTypeID() else { return nil }
  var pos = CGPoint.zero
  var size = CGSize.zero
  guard AXValueGetValue(p as! AXValue, .cgPoint, &pos),
        AXValueGetValue(s as! AXValue, .cgSize, &size) else { return nil }
  return (pos.x, pos.y, size.width, size.height)
}
var found: [String: (CGFloat, CGFloat, CGFloat, CGFloat)] = [:]
func walk(_ el: AXUIElement, _ depth: Int) {
  if depth > 14 { return }
  let role = axValue(el, kAXSubroleAttribute as String) as? String ?? ""
  if role == "AXCloseButton" || role == "AXMinimizeButton" || role == "AXZoomButton" || role == "AXFullScreenButton" {
    if let frame = box(el) { found[role] = frame }
  }
  var kids: CFTypeRef?
  if AXUIElementCopyAttributeValue(el, kAXChildrenAttribute as CFString, &kids) == .success,
     let kids = kids as? [AXUIElement] {
    for kid in kids { walk(kid, depth + 1) }
  }
}
var origin: (CGFloat, CGFloat, CGFloat, CGFloat)?
var bestArea: CGFloat = -1
for window in windows {
  walk(window, 0)
  if let frame = box(window) {
    let area = frame.2 * frame.3
    if area > bestArea {
      bestArea = area
      origin = frame
    }
  }
}
var menuRaw: CFTypeRef?
if AXUIElementCopyAttributeValue(app, kAXMenuBarAttribute as CFString, &menuRaw) == .success, let menuRaw {
  walk(unsafeBitCast(menuRaw, to: AXUIElement.self), 0)
}
guard let origin,
      let close = found["AXCloseButton"],
      let mini = found["AXMinimizeButton"],
      let zoom = found["AXZoomButton"] ?? found["AXFullScreenButton"] else {
  fputs("missing \\(Array(found.keys))\\n", stderr)
  exit(1)
}
func local(_ item: (CGFloat, CGFloat, CGFloat, CGFloat)) -> String {
  let minX = item.0 - origin.0
  return "\\(minX) \\(minX + item.2) \\(item.1 - origin.1) \\(item.1 - origin.1 + item.3)"
}
print("close \\(local(close)) mini \\(local(mini)) zoom \\(local(zoom))")
""",
    )
    crop = compile_swift(
        out,
        "shell-bar-crop",
        """
import AppKit
import CoreText
import ImageIO
import UniformTypeIdentifiers
let args = CommandLine.arguments
guard args.count > 8,
      let windowW = Double(args[3]),
      let barW = Double(args[4]),
      let closeMin = Double(args[5]),
