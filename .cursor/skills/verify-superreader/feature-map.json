  "path_rules": [
    {
      "patterns": ["spikes/shell/**", "spikes/Cargo.toml", "spikes/Cargo.lock"],
      "features": [
        "open-a-pdf",
        "read-an-epub",
        "reading-bars",
        "reading-view",
        "window-chrome",
        "sidebar",
        "bold-word-starts"
      ]
    },
    {
      "patterns": ["spikes/epub/**", "spikes/report/**"],
      "features": ["read-an-epub", "reading-view"]
    },
    {
      "patterns": ["spikes/measure/**"],
      "features": ["reading-bars", "open-a-pdf"]
    },
    {
      "patterns": ["crates/superreader-typeset/**"],
      "features": ["reading-view"]
    },
    {
      "patterns": ["scripts/verify*", "scripts/verify-lock.sh"],
      "features": [
        "open-a-pdf",
        "read-an-epub",
        "reading-bars",
        "reading-view",
        "window-chrome",
        "sidebar",
        "alpha",
        "bold-word-starts"
      ]
    },
    {
      "patterns": [".cursor/skills/verify-superreader/**"],
      "features": []
    },
    {
      "patterns": ["scripts/package-macos.sh", "scripts/make-dmg.sh", "scripts/install-app.sh"],
      "features": ["alpha"]
    }
  ]
}
